            if not entry.get("flaky")
            for outcome in outcomes
            for number in entry.get(f"{outcome}_assertions", [])
            if (file, number) not in unstable
        ))
    suite = "/".join(f"{n:,}" for n in totals)
    unstable_count = str(len(unstable))
    ipc = tomllib.load(open(f"sway-ipc/results/{name}.toml", "rb"))["run"]
    fields = "/".join(str(n) for n in (ipc.get("match", 0), ipc.get("mismatch", ipc.get("differs", 0)), ipc.get("not_applicable", 0)))
