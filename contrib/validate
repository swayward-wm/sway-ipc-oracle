    run = tomllib.load(path.open("rb")).get("run", {})
    recorded = run.get("inputs")
    if not recorded:
        raise SystemExit(f"{path}: [run] has no inputs hash")
    stale = recorded != provenance.inputs_hash(path.resolve(), run.get("compositor", ""))
    if stale and path not in pending:
        raise SystemExit(
            f"{path}: inputs changed since this result was generated; regenerate it, list it in "
            "pending.toml, or restamp it with contrib/provenance.py --restamp if the change "
            "cannot affect it"
        )
    if not stale and path in pending:
        raise SystemExit(f"{path}: listed in pending.toml but up to date; remove the entry")
