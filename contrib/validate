assert random_manifest["sway_commit"] == tomllib.load(open("pins.toml", "rb"))["sway"]
assert len(random_manifest["sequences"]) == random_manifest["seeds"]
used = set()
for sequence in random_manifest["sequences"]:
    assert len(sequence["commands"]) == random_manifest["steps"]
    assert len(sequence["observations"]) == random_manifest["steps"]
    used.update(sequence["observations"])
objects = {path.stem for path in (random_root / "objects").glob("*.json")}
assert used == objects
for digest in objects:
    value = json.loads((random_root / "objects" / f"{digest}.json").read_text())
    encoded = json.dumps(value, sort_keys=True, separators=(",", ":"))
    assert hashlib.sha256(encoded.encode()).hexdigest()[:16] == digest
