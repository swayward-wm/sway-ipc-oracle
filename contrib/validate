    expected = [f"`{stem}`", "/".join(map(str, figures)), f"`{pins[compositor][:8]}`"]
    if random_rows.get(stem) != expected:
        raise SystemExit(f"README random row for {stem} should be: | {' | '.join(expected)} |")
extra = set(random_rows) - expected_rows
if extra:
    raise SystemExit(f"README random rows without a result file: {sorted(extra)}")
