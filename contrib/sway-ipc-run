def require_clean_binary(binary: Path, compositor: str) -> str:
    probe = binary.resolve().parent
    while probe != probe.parent and not (probe / ".git").exists():
        probe = probe.parent
    if not (probe / ".git").exists():
        raise RuntimeError(f"cannot find source checkout for {binary}")
    commit = subprocess.check_output(
        ["git", "-C", probe, "rev-parse", "HEAD"], text=True
    ).strip()
    description = subprocess.check_output(
        ["git", "-C", probe, "describe", "--always", "--dirty"], text=True
    ).strip()
    dirty = subprocess.check_output(
        ["git", "-C", probe, "status", "--porcelain"], text=True
    ).strip()
    if commit != PINS[compositor]:
        raise RuntimeError(
            f"{compositor} source is {commit}, expected pinned commit {PINS[compositor]}"
        )
    if dirty or description.endswith("-dirty"):
        raise RuntimeError(f"refusing to measure dirty {compositor} build ({description})")
    return commit


def reject_dirty_version(compositor: str, version: str, commit: str) -> None:
    if re.search(r"(?:-dirty|-modified)\b", version) or commit.endswith(("-dirty", "-modified")):
        raise RuntimeError(f"refusing to record dirty {compositor} build: {version}")


def fake_output_count(scenario):
    return len(scenario.get("output_layout") or []) or scenario.get("outputs", 1)


def fake_output_name(prefix, index, count):
    """i3's fake-<index> as a headless output name.

    wlroots' headless backend announces its outputs last-first, so the
    compositor gives workspace 1 to <prefix>-<count>. i3 gives it to fake-0.
    Mapping fake-N to the output announced N-th keeps i3's premise that fake-0
    is the first output, holds workspace 1 and has the initial focus. The i3
    suite adapters use the same mapping.
    """
    return f"{prefix}-{count - index}"


def translate_fake_outputs(text, prefix, count):
    return re.sub(r"\bfake-(\d+)\b", lambda match: fake_output_name(prefix, int(match[1]), count), text)


def initial_fake_focus(scenario):
    focus = scenario.get("initial_focus")
    if focus is not None:
        return focus
    layout = scenario.get("output_layout") or []
    return next((index for index, (*_, primary) in enumerate(layout) if primary), 0)


def generate_commands(seed, steps):
    """Return a reproducible sequence of sway command strings."""
    rng = random.Random(seed)
    commands, next_window = [
        "exec foot --app-id=fixture-diff-1 --title=fixture-diff-1 sh -c 'sleep 300'"
    ], 2
    for _ in range(max(0, steps - 1)):
        if rng.random() < 0.22:
            ident = f"fixture-diff-{next_window}"
            next_window += 1
            commands.append(
                f"exec foot --app-id={ident} --title={ident} sh -c 'sleep 300'"
            )
        else:
            commands.append(rng.choice(COMMANDS))
    return commands


def random_v2_vocabulary():
    """Flat command list of sway-ipc/random-v2/vocabulary.json, in file order."""
    vocabulary = json.loads((RANDOM_V2 / "vocabulary.json").read_text())
    return vocabulary, [command for family in vocabulary["families"]
                        if family["name"] != vocabulary["window_family"]
                        for command in family["commands"]]


def generate_commands_v2(seed, steps):
    """Return a reproducible random-v2 sequence drawn from the vocabulary.

    The prelude runs as observed steps so a minimised reproducer carries it.
    """
    vocabulary, commands_pool = random_v2_vocabulary()
    window = next(family for family in vocabulary["families"]
                  if family["name"] == vocabulary["window_family"])["commands"][0]
    rng = random.Random(f"random-v2:{seed}")
    commands = [*vocabulary["prelude"], window.format(ident="fixture-diff-1")]
    next_window = 2
    while len(commands) < steps:
        if rng.random() < vocabulary["window_probability"]:
            commands.append(window.format(ident=f"fixture-diff-{next_window}"))
            next_window += 1
        else:
            commands.append(rng.choice(commands_pool))
    return commands[:max(0, steps)]


