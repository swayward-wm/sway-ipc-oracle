def normalize(value, rules, path="$", is_output=False, under_floating=False,
              under_hidden=False, in_scratch=False):
    if isinstance(value, dict):
        output = value.get("type") == "output"
        child_under_floating, child_under_hidden, child_in_scratch = tree_context(
            value, under_floating, under_hidden, in_scratch)
        ignored = {key for rule in rules["ignore_key"] for key in rule["keys"]}
        output_ignored = {key for rule in rules["ignore_output_key"] for key in rule["keys"]}
        suffixes = tuple(suffix for rule in rules["ignore_path"] for suffix in rule["suffixes"])
        shape_paths = {item for rule in rules["shape_path"] for item in rule["paths"]}
        conditional_ignores = [rule for rule in rules["tree_field_rule"]
                               if rule["action"] == "ignore"
                               and rule_matches(rule, value, under_floating, under_hidden)]
        for key, child in value.items():
            child_path = f"{path}.{key}"
            if child_path in shape_paths:
                value[key] = shape_view(child)
            elif (key in ignored or (output and key in output_ignored)
                    or child_path.endswith(suffixes)
                    or any(rule["field"] == key for rule in conditional_ignores)):
                value[key] = NORMAL
            else:
                normalize(child, rules, child_path, output, child_under_floating,
                          child_under_hidden, child_in_scratch)
    elif isinstance(value, list):
        for index, child in enumerate(value):
            normalize(child, rules, f"{path}[{index}]", is_output, under_floating,
                      under_hidden, in_scratch)


def diff_values(expected, actual, path, differences, ignored_array_suffixes, numeric_tolerances):
    if type(expected) is not type(actual):
        differences.append(f"{path}: type {type(expected).__name__} != {type(actual).__name__}")
    elif isinstance(expected, dict):
        if expected.keys() != actual.keys():
            differences.append(f"{path}: keys differ")
        for key in sorted(expected.keys() & actual.keys()):
            diff_values(expected[key], actual[key], f"{path}.{key}", differences,
                        ignored_array_suffixes, numeric_tolerances)
    elif isinstance(expected, list):
        if not path.endswith(ignored_array_suffixes) and len(expected) != len(actual):
            differences.append(f"{path}: length {len(expected)} != {len(actual)}")
        for index, (left, right) in enumerate(zip(expected, actual)):
            diff_values(left, right, f"{path}[{index}]", differences,
                        ignored_array_suffixes, numeric_tolerances)
    elif expected != actual:
        tolerance = next((value for suffix, value in numeric_tolerances
                          if path.endswith(suffix)), None)
        if (tolerance is None or not isinstance(expected, (int, float))
                or not isinstance(actual, (int, float))
                or abs(expected - actual) >= tolerance):
            differences.append(f"{path}: {expected!r} != {actual!r}")


def tree_pairs(expected, actual, path="$tree", under_floating=False, under_hidden=False,
               in_scratch=False):
    yield expected, actual, path, under_floating, under_hidden
    child_context = tree_context(expected, under_floating, under_hidden, in_scratch)
    for key in ("nodes", "floating_nodes"):
        for index, pair in enumerate(zip(expected.get(key, []), actual.get(key, []))):
            yield from tree_pairs(*pair, f"{path}.{key}[{index}]", *child_context)


def semantic_tree_diffs(expected, actual, rules):
    differences = []
    rect_rule = tree_field_rules(rules, "rect", "rect_tolerance")[0]
    percent_rule = tree_field_rules(rules, "percent", "numeric_tolerance")[0]
    rect_ignores = tree_field_rules(rules, "rect", "ignore")
    percent_ignores = tree_field_rules(rules, "percent", "ignore")
    tolerance = rect_rule["tolerance"]
    epsilon = percent_rule["tolerance"]
    for left, right, path, under_floating, under_hidden in tree_pairs(expected, actual):
        rect_ignored = any(rule_matches(rule, left, under_floating, under_hidden)
                           for rule in rect_ignores)
        if not rect_ignored:
            for key in ("x", "y", "width", "height"):
                if abs(left["rect"][key] - right["rect"][key]) > tolerance:
                    differences.append(f"{path}.rect.{key}: outside {tolerance}px tolerance")
        expected_children = left.get("nodes", []) + left.get("floating_nodes", [])
        actual_children = right.get("nodes", []) + right.get("floating_nodes", [])
        mapping = {a.get("id"): b.get("id") for a, b in zip(expected_children, actual_children)}
        mapped_focus = [mapping[item] for item in left.get("focus", []) if item in mapping]
        actual_ids = {child.get("id") for child in actual_children}
        actual_focus = [item for item in right.get("focus", []) if item in actual_ids]
        if mapped_focus != actual_focus:
            differences.append(f"{path}.focus: child-position order differs")
        if not any(rule_matches(rule, left, under_floating, under_hidden)
                   for rule in percent_ignores):
            lp, rp = left.get("percent"), right.get("percent")
            if ((lp is None) != (rp is None)
                    or (lp is not None and (not isinstance(lp, (int, float))
                        or not isinstance(rp, (int, float)) or abs(lp - rp) >= epsilon))):
                differences.append(f"{path}.percent: differs")
        if left.get("type") == "con" and not left.get("nodes"):
            # The relationship compares a role with the outer rect, so it is
            # meaningless where the rect itself is exempt.
            for role in ("window_rect", "deco_rect", "geometry"):
                if rect_ignored:
                    break
                if (left.get(role) == left.get("rect")) != (right.get(role) == right.get("rect")):
                    differences.append(f"{path}.{role}: outer-rect relationship differs")
            if (left["deco_rect"]["height"] > 0) != (right["deco_rect"]["height"] > 0):
                differences.append(f"{path}.deco_rect: titlebar presence differs")
    return differences


def align_outputs_by_name(expected, actual):
    if not isinstance(expected, list) or not isinstance(actual, list):
        return actual
    by_name = {
        item.get("name", "").casefold(): item
        for item in actual
        if isinstance(item, dict) and isinstance(item.get("name"), str)
    }
    names = [
        item.get("name", "").casefold()
        for item in expected
        if isinstance(item, dict) and isinstance(item.get("name"), str)
    ]
    if len(names) != len(expected) or len(by_name) != len(actual) or set(names) != set(by_name):
        return actual
    return [by_name[name] for name in names]


def compare(expected, actual, request, rules):
    differences = []
    ignored = tuple(rules["arrays"]["ignore_length_suffixes"])
    left, right = copy.deepcopy(expected), copy.deepcopy(actual)
    if request == "outputs":
        right = align_outputs_by_name(left, right)
    normalize(left, rules, f"${request}")
    normalize(right, rules, f"${request}")
    numeric_tolerances = [(f".{rule['field']}", rule["tolerance"])
                          for rule in rules["tree_field_rule"]
                          if rule["action"] == "numeric_tolerance"]
    diff_values(left, right, f"${request}", differences, ignored, numeric_tolerances)
    if request == "tree" and not differences:
        differences.extend(semantic_tree_diffs(expected, actual, rules))
    return list(dict.fromkeys(differences))


class Adapter:
    capabilities = frozenset()
    def __init__(self, args, run_dir, scenario=None):
        self.args, self.run_dir, self.scenario = args, run_dir, scenario or {}
        wayland_socket = run_dir / "wayland-1"
        if len(os.fsencode(wayland_socket)) >= 100:
            raise RuntimeError(
                f"run directory is too long for a Wayland socket: {wayland_socket}"
            )
        self.socket = run_dir / "ipc.sock"
        self.process = None
        self.clients = []
        self.env = os.environ.copy()
        self.marker = f"{os.getpid()}-{time.monotonic_ns()}"
        self.env[RUN_MARKER] = self.marker
        for name in ("SWAYSOCK", "I3SOCK", "WAYLAND_DISPLAY", "DISPLAY"):
            self.env.pop(name, None)
        self.env["FOOT_SERVER_SOCKET"] = str(run_dir / "no-foot-server")

    def wrapped(self, command):
        limited = ["timeout", "--kill-after=5", str(self.args.timeout), *command]
        if os.environ.get("ORACLE_CONTAINER") == "1":
            return limited
        return ["systemd-run", "--user", "--scope", "--quiet", "-p", "MemoryMax=2G",
                "-p", "MemorySwapMax=0", *limited]

    def check_started_build(self, version_reply):
        """Every started process must be the pinned build.

        The source checkout is checked once before a run, but a binary rebuilt
        from a later commit mid-run would otherwise be measured and recorded
        under the earlier pin.
        """
        name = next(key for key, adapter in ADAPTERS.items() if adapter is type(self))
        details = getattr(type(self), "version_details", None)
        if details is None:
            return version_reply
        version, commit = details(version_reply)
        if commit == "unknown" or not PINS[name].startswith(commit):
            raise RuntimeError(
                f"started {name} reports {version!r}, expected pinned commit "
                f"{PINS[name][:8]}; was the binary rebuilt during the run?"
            )
        return version_reply

    def start_process(self, command, log):
        runtime = self.env.pop("XDG_RUNTIME_DIR", None)
        if runtime:
            command = ["env", f"XDG_RUNTIME_DIR={runtime}", *command]
        self.process = subprocess.Popen(self.wrapped(command), env=self.env, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
        wait_for(lambda: self.socket.exists() or self.process.poll() is not None, "private IPC socket")
        if self.process.poll() is not None:
            log.flush()
            tail = Path(log.name).read_text(errors="replace").splitlines()[-40:]
            detail = "\n" + "\n".join(tail) if tail else ""
            raise RuntimeError(f"compositor exited with {self.process.returncode}{detail}")

    def stop(self):
        for client in self.clients:
            if client.poll() is None:
                client.terminate()
        for client in self.clients:
            try:
                client.wait(1)
            except subprocess.TimeoutExpired:
                client.kill()
                client.wait()
        if self.process and self.process.poll() is None:
            os.killpg(self.process.pid, signal.SIGTERM)
            try:
                self.process.wait(3)
            except subprocess.TimeoutExpired:
                os.killpg(self.process.pid, signal.SIGKILL)
                self.process.wait()
        reap_marked_processes(self.marker)
        self.reap_children()

    @staticmethod
    def reap_children():
        while True:
            try:
                pid, _ = os.waitpid(-1, os.WNOHANG)
            except ChildProcessError:
                return
            if pid == 0:
                return

    def command_reply(self, text):
        return ipc(self.socket, "command", self.translate_command(text))

    def translate_command(self, text):
        return text

    def run_command(self, text):
        reply = self.command_reply(text)
        if not isinstance(reply, list) or not all(item.get("success") for item in reply):
            raise RuntimeError(f"command failed: {text}: {reply}")

    def reset(self):
        reply = ipc(self.socket, "command", '[app_id="^fixture-"] kill')
        if not isinstance(reply, list) or not all(item.get("success") or item.get("error") == "No matching node." for item in reply):
            raise RuntimeError(f"fixture cleanup failed: {reply}")
        wait_for(lambda: fixture_window_count(ipc(self.socket, "tree")) == 0, "fixture windows to close")
        self.run_command("workspace __fixture_reset")
        self.run_command("workspace 1")

    def open_window(self, ident):
        raise NotImplementedError


class FixtureUnavailable(RuntimeError):
    pass


class WaylandAdapter(Adapter):
    capabilities = frozenset({"xdg-toplevel-size-hints", "wlr-foreign-toplevel-management"})
    config_text = ""

    def rendered_config(self):
        return self.config_text

    def fixture_client(self):
        binary = self.run_dir / "xdg-toplevel-fixture"
        if binary.exists():
            return binary
        for tool in ("pkg-config", "wayland-scanner", "cc"):
            if shutil.which(tool) is None:
                raise FixtureUnavailable(f"fixture client unavailable (missing {tool})")
        for package in ("wayland-protocols", "wayland-client"):
            if subprocess.run(
                ["pkg-config", "--exists", package], check=False
            ).returncode:
                raise FixtureUnavailable(
                    f"fixture client unavailable (missing {package})"
                )
        protocols = subprocess.check_output(
            ["pkg-config", "--variable=pkgdatadir", "wayland-protocols"], text=True
        ).strip()
        protocol = Path(protocols) / "stable/xdg-shell/xdg-shell.xml"
        header = self.run_dir / "xdg-shell-client-protocol.h"
        code = self.run_dir / "xdg-shell-protocol.c"
        try:
            subprocess.run(["wayland-scanner", "client-header", protocol, header], check=True)
            subprocess.run(["wayland-scanner", "private-code", protocol, code], check=True)
            flags = shlex.split(subprocess.check_output(
                ["pkg-config", "--cflags", "--libs", "wayland-client"], text=True
            ))
            subprocess.run([
                "cc", "-std=c11", "-Wall", "-Wextra", "-Werror", f"-I{self.run_dir}",
                ROOT / "contrib/xdg-toplevel-fixture.c", code, "-o", binary, *flags,
            ], check=True)
        except subprocess.CalledProcessError as error:
            raise FixtureUnavailable("fixture client unavailable (build failed)") from error
        return binary

    def foreign_toplevel_client(self):
        binary = self.run_dir / "foreign-toplevel-request"
        if binary.exists():
            return binary
        for tool in ("pkg-config", "wayland-scanner", "cc"):
            if shutil.which(tool) is None:
                raise FixtureUnavailable(f"foreign-toplevel client unavailable (missing {tool})")
        if subprocess.run(["pkg-config", "--exists", "wayland-client"], check=False).returncode:
            raise FixtureUnavailable("foreign-toplevel client unavailable (missing wayland-client)")
        protocol = ROOT / "contrib/protocols/wlr-foreign-toplevel-management-unstable-v1.xml"
        header = self.run_dir / "wlr-foreign-toplevel-management-unstable-v1-client-protocol.h"
        code = self.run_dir / "wlr-foreign-toplevel-management-unstable-v1-protocol.c"
        try:
            subprocess.run(["wayland-scanner", "client-header", protocol, header], check=True)
            subprocess.run(["wayland-scanner", "private-code", protocol, code], check=True)
            flags = shlex.split(subprocess.check_output(
                ["pkg-config", "--cflags", "--libs", "wayland-client"], text=True
            ))
            subprocess.run([
                "cc", "-std=c11", "-Wall", "-Wextra", "-Werror", f"-I{self.run_dir}",
                ROOT / "contrib/foreign-toplevel-request.c", code, "-o", binary, *flags,
            ], check=True)
        except subprocess.CalledProcessError as error:
            raise FixtureUnavailable("foreign-toplevel client unavailable (build failed)") from error
        return binary

    def foreign_toplevel_request(self, ident, request):
        """Send one wlr foreign-toplevel request to the toplevel with app_id `ident`."""
        arguments = [ident, request]
        subprocess.run(
            [self.foreign_toplevel_client(), *arguments], env={
                **self.env, "WAYLAND_DISPLAY": self.display,
                "XDG_RUNTIME_DIR": str(self.run_dir),
            }, stdout=subprocess.DEVNULL, check=True, timeout=10,
        )
        text = "foreign-toplevel-request " + " ".join(arguments)
        return command_observation(text, [{"success": True}])

    def open_window_command(self, ident, title):
        return f"exec foot --app-id={shlex.quote(ident)} --title={shlex.quote(title)} sh -c 'sleep 300'"

    def start(self, log):
        config = self.run_dir / self.config_name
        config.write_text(self.rendered_config())
        self.env.update({"WLR_BACKENDS": "headless", "WLR_HEADLESS_OUTPUTS": str(self.scenario.get("outputs", 1)), "SWAYSOCK": str(self.socket), "XDG_RUNTIME_DIR": str(self.run_dir)})
        self.start_process([str(self.args.binary), "-c", str(config)], log)
        version = self.check_started_build(ipc(self.socket, "version"))
        self.display = wait_for(self.find_display, "private Wayland socket")
        return version

    def find_display(self):
        sockets = [path for path in self.run_dir.glob("wayland-*") if not path.name.endswith(".lock")]
        return sockets[0].name if sockets else None

    def open_window(self, ident, title=None):
        before = fixture_window_count(ipc(self.socket, "tree"))
        title = title or ident
        text = self.open_window_command(ident, title)
        reply = self.command_reply(text)
        if not isinstance(reply, list) or not all(item.get("success") for item in reply):
            raise RuntimeError(f"command failed: {text}: {reply}")
        wait_for(lambda: fixture_window_count(ipc(self.socket, "tree")) == before + 1, ident)
        return command_observation(text, reply)

    def open_hinted_window(self, ident, min_width, min_height, max_width, max_height,
                           parent):
        before = fixture_window_count(ipc(self.socket, "tree"))
        arguments = [ident, min_width, min_height, max_width, max_height, int(parent)]
        client = subprocess.Popen(
            [self.fixture_client(), *map(str, arguments)], env={
                **self.env, "WAYLAND_DISPLAY": self.display,
                "XDG_RUNTIME_DIR": str(self.run_dir),
            }, stdout=subprocess.DEVNULL,
        )
        self.clients.append(client)
        added = 2 if parent else 1
        wait_for(lambda: fixture_window_count(ipc(self.socket, "tree")) == before + added,
                 ident)
        text = "xdg-toplevel-fixture " + " ".join(map(str, arguments))
        return command_observation(text, [{"success": True}])


