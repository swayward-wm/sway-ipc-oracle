def differential_action(adapter, text):
    before = fixture_window_count(ipc(adapter.socket, "tree"))
    if isinstance(adapter, I3Adapter) and text.startswith("exec foot --app-id="):
        ident = text.split("--app-id=", 1)[1].split(" ", 1)[0]
        text = f"exec --no-startup-id xterm -name {ident} -title {ident}"
    reply = adapter.command_reply(text)
    if (text.startswith(("exec foot --app-id=", "exec --no-startup-id xterm -name "))
            and reply and reply[0].get("success")):
        wait_for(lambda: fixture_window_count(ipc(adapter.socket, "tree")) > before,
                 "generated window")
    else:
        time.sleep(0.03)
    return reply


def differential_once(args, commands, keep_state=False):
    """Run one sequence on fresh compositors and return its first divergence."""
    with tempfile.TemporaryDirectory(prefix="sio-") as directory:
        base = Path(directory)
        adapters = []
        versions = []
        logs = []
        try:
            for label, compositor, binary in (
                ("a", args.a, args.a_binary), ("b", args.b, args.b_binary)
            ):
                run_dir = base / label
                run_dir.mkdir()
                adapter_args = argparse.Namespace(binary=binary, timeout=args.timeout)
                adapter = ADAPTERS[compositor](adapter_args, run_dir)
                if compositor in DIFFERENTIAL_CONFIGS:
                    adapter.config_text = DIFFERENTIAL_CONFIGS[compositor]
                log = open(run_dir / "compositor.log", "w")
                logs.append(log)
                versions.append(adapter.start(log))
                adapters.append(adapter)
                reply = adapter.command_reply("output * mode --custom 1280x720@60Hz")
                if not reply or not reply[0].get("success"):
                    raise RuntimeError(f"could not set differential output mode: {reply}")
            rules = load_rules()
            for step, text in enumerate(commands, 1):
                replies = [differential_action(adapter, text) for adapter in adapters]
                observations = {"command": replies}
                for request in ("tree", "workspaces"):
                    observations[request] = [ipc(adapter.socket, request) for adapter in adapters]
                for request, pair in observations.items():
                    differences = compare(pair[0], pair[1], request, rules)
                    if differences:
                        result = {
                            "step": step, "command": text, "request": request,
                            "differences": differences,
                        }
                        if keep_state:
                            result["sway_state"] = {
                                "command": observations["command"][0],
                                "tree": observations["tree"][0],
                                "workspaces": observations["workspaces"][0],
                                "outputs": ipc(adapters[0].socket, "outputs"),
                            }
                        return result, versions
            return None, versions
        finally:
            for adapter in reversed(adapters):
                adapter.stop()
            for log in logs:
                log.close()


def append_regression_scenario(seed, commands, state):
    name = f"differential_seed_{seed}"
    scenario_path = ROOT / "sway-ipc/scenarios.toml"
    existing = tomllib.loads(scenario_path.read_text())["scenario"]
    if name not in {item["name"] for item in existing}:
        actions = []
        for index, text in enumerate(commands):
            if text.startswith("exec foot --app-id=fixture-diff-"):
                ident = text.split("--app-id=", 1)[1].split(" ", 1)[0]
                actions.append(f"window:{ident}")
            elif index == len(commands) - 1:
                actions.append(f"probe:{name}:{text}")
            else:
                actions.append(f"step:{text}")
        actions.append(f"capture:{name}")
        with open(scenario_path, "a") as file:
            file.write(f"\n[[scenario]]\nname = {toml_string(name)}\n")
            file.write("actions = [" + ", ".join(toml_string(item) for item in actions) + "]\n")
    has_probe = any(action.startswith(f"probe:{name}:") for action in actions)
    for request, value in state.items():
        if request == "command" and not has_probe:
            continue
        (FIXTURES / f"{name}.{request}.json").write_text(
            json.dumps(value, indent=2, sort_keys=True) + "\n"
        )
    return name


def capture_individual_events(adapter):
    events = FIXTURES / "events"

    def save(family, change, trigger):
        event = subscribed_event(adapter.socket, family, trigger)
        if event.get("change") != change:
            raise RuntimeError(f"expected {family}::{change}, got {event.get('change')}")
        (events / f"{family}.{change}.json").write_text(json.dumps(event, indent=2, sort_keys=True) + "\n")

    adapter.reset()
    save("workspace", "reload", lambda: adapter.run_command("reload"))
    save("mode", "resize", lambda: adapter.run_command("mode resize"))
    save("mode", "default", lambda: adapter.run_command("mode default"))

    adapter.open_window("fixture-event-one")
    save("window", "floating", lambda: adapter.run_command("floating enable"))
    save("window", "fullscreen_mode", lambda: adapter.run_command("fullscreen enable"))
    save("window", "mark", lambda: adapter.run_command("mark eventmark"))
    save("window", "title", lambda: adapter.run_command("title_format event-title"))
    save("window", "move", lambda: adapter.run_command("move workspace 2"))
    adapter.run_command("workspace 1")
    save("workspace", "urgent", lambda: adapter.run_command('[app_id="^fixture-event-one$"] urgent enable'))
    save("window", "urgent", lambda: adapter.run_command('[app_id="^fixture-event-one$"] urgent disable, urgent enable'))
    save("workspace", "focus", lambda: adapter.run_command("workspace 2"))
    save("workspace", "rename", lambda: adapter.run_command("rename workspace 2 to event-renamed"))
    save("window", "close", lambda: adapter.run_command('[app_id="^fixture-event-one$"] kill'))


def shape_of(tree):
    """Keep layout semantics while dropping runtime identity and geometry."""
    def node(value):
        result = {
            key: value.get(key) for key in
            ("type", "layout", "orientation", "floating", "fullscreen_mode", "sticky")
            if key in value
        }
        result["nodes"] = [node(child) for child in value.get("nodes", [])]
        result["floating_nodes"] = [node(child) for child in value.get("floating_nodes", [])]
        return result
    return node(tree)


def load_i3_logs(directory):
    records = []
    for path in sorted(directory.glob("*.commands.jsonl")):
        for line in path.read_text().splitlines():
            if line.strip():
                records.append(json.loads(line))
    return records


def i3_log_segments(records):
    segments, segment = [], []
    setup = {"outputs": 1, "workspace_outputs": []}
    for record in records:
        if record["kind"] == "reset":
            if segment:
                segments.append((setup, segment))
                segment = []
            value = record["value"]
            setup = ({"outputs": value.get("outputs", 1),
                      "output_layout": value.get("output_layout", []),
                      "initial_focus": value.get("initial_focus"),
                      "workspace_outputs": value.get("workspace_outputs", [])}
                     if isinstance(value, dict) else
                     {"outputs": 1, "output_layout": [], "initial_focus": None,
                      "workspace_outputs": []})
        else:
            segment.append(record)
    if segment:
        segments.append((setup, segment))
    return segments


def query_state(adapter, compositor):
    applicability = load_applicability()["i3"]
    return {
        request: ipc(adapter.socket, request)
        for request in QUERY_REQUESTS
        if compositor != "i3" or applicability[request].get("applicable", True)
    }


def settled_state(adapter, compositor):
    previous = None
    consecutive = 0
    for _ in range(40):
        state = query_state(adapter, compositor)
        encoded = json.dumps(state, sort_keys=True)
        consecutive = consecutive + 1 if encoded == previous else 1
        if consecutive == 3:
            return state
        previous = encoded
        time.sleep(0.05)
    raise RuntimeError("i3-derived state did not settle")


def replay_i3_segment(adapter, records, capture, seen, scenarios, skips):
    actions, command_replies = [], []
    for index, record in enumerate(records, 1):
        kind, value = record["kind"], record["value"]
        if kind == "command":
            session_bound = ("[id=", "[con_id=", "[class=", "[instance=",
                             "[title=", "[window_role=", "[window_type=")
            if (any(token in value for token in session_bound)
                    or value.strip() in ("restart", "exit")
                    or "exec " in value or "bar " in value):
                skips.append({"test": record["test"], "line": record["line"],
                              "reason": f"not replayable outside the originating X11 session: {value}"})
                break
        if kind == "window":
            ident = f"fixture-i3-{len(actions) + 1}"
            command_replies.append(adapter.open_window(ident))
            time.sleep(0.15)
            actions.append({"kind": "window", "value": ident})
        elif kind == "command":
            reply = adapter.command_reply(value)
            actions.append({"kind": "command", "value": value})
            command_replies.append(command_observation(value, reply))
        else:
            continue
        try:
            state = settled_state(adapter, "sway")
        except OSError as error:
            skips.append({"test": record["test"], "line": record["line"],
                          "reason": f"replay terminated the compositor: {error}"})
            break
        setup = {
            "outputs": len(state["outputs"]),
            "output_layout": copy.deepcopy(adapter.scenario.get("output_layout", [])),
            "initial_focus": adapter.scenario.get("initial_focus"),
            "workspace_outputs": copy.deepcopy(adapter.scenario.get("workspace_outputs", [])),
        }
        shape = json.dumps(
            {"setup": setup, "tree": shape_of(state["tree"])},
            sort_keys=True, separators=(",", ":")
        )
        digest = hashlib.sha256(shape.encode()).hexdigest()[:16]
        if digest in seen:
            continue
        seen.add(digest)
        scenario = {
            "name": digest,
            "provenance": {"test": record["test"], "line": record["line"]},
            **setup,
            "actions": copy.deepcopy(actions),
        }
        scenarios.append(scenario)
        if capture:
            state["commands"] = copy.deepcopy(command_replies)
            (I3_DERIVED / f"{digest}.json").write_text(
                json.dumps(state, sort_keys=True, separators=(",", ":")) + "\n"
            )


def replay_i3_derived_scenario(args, scenario, suffix=""):
    with tempfile.TemporaryDirectory(prefix="sio-") as directory:
        run_dir = Path(directory)
        adapter = ADAPTERS[args.compositor](args, run_dir, scenario)
        with open(run_dir / f"compositor{suffix}.log", "w") as log:
            try:
                version_reply = adapter.start(log)
                command_replies = []
                for action in scenario["actions"]:
                    if action["kind"] == "window":
                        command_replies.append(adapter.open_window(action["value"]))
                        time.sleep(0.15)
                    else:
                        reply = adapter.command_reply(action["value"])
                        command_replies.append(command_observation(action["value"], reply))
                actual = settled_state(adapter, args.compositor)
                actual["commands"] = command_replies
                return version_reply, actual
            finally:
                adapter.stop()


def i3_derived_result_rows(args, scenario, expected, actual, rules, applicability):
    rows = []
    for request in (*QUERY_REQUESTS, "commands"):
        applicable = applicability["i3"][request].get("applicable", True)
        if args.compositor == "i3" and not applicable:
            rows.append({
                "scenario": f"i3-derived/{scenario['name']}", "request": request,
                "verdict": "not applicable", "reason": applicability["i3"][request]["reason"],
            })
            continue
        left, right, excluded = expected[request], actual[request], []
        if request == "version":
            left, right = shape_view(left), shape_view(right)
        elif args.compositor == "i3":
            left, right, excluded = i3_protocol_view(left, right, request, applicability)
        differences = compare(left, right, request, rules)
        verdict = "differs" if args.compositor == "i3" and differences else "mismatch" if differences else "match"
        row = {"scenario": f"i3-derived/{scenario['name']}", "request": request,
               "verdict": verdict, "differences": differences}
        if scenario.get("output_layout"):
            row["adapted"] = ["source-fake-output-layout"]
        rows.append(row)
        if excluded:
            rows.append({
                "scenario": f"i3-derived/{scenario['name']}", "request": request,
                "verdict": "not applicable",
                "reason": f"sway extension fields: {', '.join(excluded)}; source: {applicability['i3'][request]['sway_extension_source']}",
            })
    return rows


def classify_i3_derived_instability(rows, retry_rows):
    for row, retry in zip(rows, retry_rows, strict=True):
        if row["verdict"] not in ("mismatch", "differs"):
            continue
        if (row["verdict"], row.get("differences")) != (retry["verdict"], retry.get("differences")):
            row["verdict"] = "unstable"


def i3_derived_main(args, parser):
    if args.binary is None or args.compositor is None:
        parser.error("i3-derived requires --compositor and --binary")
    if args.capture and args.compositor != "sway":
        parser.error("i3-derived capture is restricted to sway")
    manifest_path = I3_DERIVED / "scenarios.json"
    if args.capture:
        if args.command_logs is None:
            parser.error("i3-derived --capture requires --command-logs")
        I3_DERIVED.mkdir(parents=True, exist_ok=True)
        for path in I3_DERIVED.glob("*.json"):
            path.unlink()
        records = load_i3_logs(args.command_logs)
        scenarios, skips, seen = [], [], set()
        for setup, segment in i3_log_segments(records):
            with tempfile.TemporaryDirectory(prefix="sio-") as directory:
                adapter = ADAPTERS["sway"](args, Path(directory), setup)
                with open(Path(directory) / "compositor.log", "w") as log:
                    try:
                        adapter.start(log)
                        replay_i3_segment(adapter, segment, True, seen, scenarios, skips)
                    finally:
                        adapter.stop()
        manifest = {
            "description": "States reached by i3's unchanged tests, captured from sway 1.12",
            "scenarios": scenarios, "skips": skips,
        }
        manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
        print(f"captured {len(scenarios)} distinct shapes; skipped {len(skips)} sequences")
        return 0

    manifest = json.loads(manifest_path.read_text())
    scenarios = manifest["scenarios"]
    if args.scenario:
        unknown = set(args.scenario) - {item["name"] for item in scenarios}
        if unknown:
            raise RuntimeError("unknown i3-derived scenarios: " + ", ".join(sorted(unknown)))
        scenarios = [item for item in scenarios if item["name"] in args.scenario]
    rules, applicability, rows = load_rules(), load_applicability(), []
    for scenario in scenarios:
        version_reply, actual = replay_i3_derived_scenario(args, scenario)
        expected = json.loads((I3_DERIVED / f"{scenario['name']}.json").read_text())
        result = i3_derived_result_rows(args, scenario, expected, actual, rules, applicability)
        if any(row["verdict"] in ("mismatch", "differs") for row in result):
            _, retry = replay_i3_derived_scenario(args, scenario, "-retry")
            retry_rows = i3_derived_result_rows(
                args, scenario, expected, retry, rules, applicability
            )
            classify_i3_derived_instability(result, retry_rows)
        rows.extend(result)
    version, commit = ADAPTERS[args.compositor].version_details(version_reply)
    out = args.out or ROOT / "sway-ipc/results" / f"{PINS['snapshot'][args.compositor]}-i3-derived.toml"
    counts, _ = write_results(out, args.compositor, version, commit, rows, rules,
                              "fresh compositor per derived i3 state", unstable=True)
    print("; ".join(f"{key}: {counts[key]}" for key in counts))
    return bool(counts.get("mismatch", 0))


def store_random_object(objects, value):
    """Add one canonical JSON value to a content-addressed object map."""
    encoded = json.dumps(value, sort_keys=True, separators=(",", ":"))
    digest = hashlib.sha256(encoded.encode()).hexdigest()[:16]
    objects.setdefault(digest, encoded)
    return digest

def random_result_rows(seed, commands, expected, actual, rules):
    """Return the first per-step divergence, or one matching seed row."""
    for index, (left, right) in enumerate(zip(expected, actual), 1):
        for request in ("command", "tree", "workspaces"):
            differences = compare(left[request], right[request], request, rules)
            if differences:
                return [{"seed": seed, "verdict": "mismatch", "step": index,
                         "request": request, "commands": commands[:index],
                         "differences": differences}]
    if len(expected) != len(actual):
        return [{"seed": seed, "verdict": "mismatch", "step": len(actual) + 1,
                 "request": "sequence", "commands": commands[:len(actual) + 1],
                 "differences": [f"$sequence: length {len(expected)} != {len(actual)}"]}]
    return [{"seed": seed, "verdict": "match"}]

def random_observation(adapter, text):
    reply = differential_action(adapter, text)
    previous = None
    for _ in range(40):
        state = {request: ipc(adapter.socket, request)
                 for request in ("tree", "workspaces")}
        encoded = json.dumps(state, sort_keys=True)
        if encoded == previous:
            return state | {"command": reply}
        previous = encoded
        time.sleep(0.05)
    raise RuntimeError("random sequence state did not settle")

def random_manifest(root=RANDOM):
    manifest = json.loads((root / "sequences.json").read_text())
    objects = {
        path.stem: json.loads(path.read_text())
        for path in (root / "objects").glob("*.json")
    }
    return manifest, objects

def random_capture(args, parser):
    if args.compositor != "sway":
        parser.error("random --capture is restricted to sway")
    require_clean_binary(args.binary, "sway")
    objects, sequences = {}, []
    with tempfile.TemporaryDirectory(prefix="sio-") as directory:
        return random_capture_in(args, objects, sequences, Path(directory))


def random_capture_in(args, objects, sequences, scratch):
    for seed in range(args.seed, args.seed + args.seeds):
        commands = GENERATORS[args.generator](seed, args.steps)
        run_dir = scratch / str(seed)
        shutil.rmtree(run_dir, ignore_errors=True)
        run_dir.mkdir()
        adapter = SwayAdapter(args, run_dir)
        adapter.config_text = DIFFERENTIAL_CONFIGS["sway"]
        with open(run_dir / "compositor.log", "w") as log:
            try:
                adapter.start(log)
                reply = adapter.command_reply("output * mode --custom 1280x720@60Hz")
                if not reply or not reply[0].get("success"):
                    raise RuntimeError(f"could not set random output mode: {reply}")
                observations = [store_random_object(objects, random_observation(adapter, text))
                                for text in commands]
            finally:
                adapter.stop()
        sequences.append({"seed": seed, "commands": commands,
                          "observations": observations})
        shutil.rmtree(run_dir)
        if (seed - args.seed + 1) % 25 == 0:
            print(f"captured {seed - args.seed + 1}/{args.seeds} seeds", flush=True)
    root = RANDOM_ROOTS[args.generator]
    object_dir = root / "objects"
    # Only captured data is replaced; random-v2 keeps its vocabulary file.
    shutil.rmtree(object_dir, ignore_errors=True)
    object_dir.mkdir(parents=True)
    for digest, encoded in sorted(objects.items()):
        (object_dir / f"{digest}.json").write_text(encoded + "\n")
    manifest = {
        "description": "Seeded command sequences and per-step replies captured from sway 1.12",
        "sway_commit": PINS["sway"], "seed_start": args.seed,
        "seeds": args.seeds, "steps": args.steps, "sequences": sequences,
        "excluded": [],
    }
    if args.generator != "v1":
        manifest["generator"] = args.generator
        # Seeds whose repeated sway replays disagreed with this capture.
        manifest["unstable"] = []
    (root / "sequences.json").write_text(
        json.dumps(manifest, indent=2, sort_keys=True) + "\n"
    )
    print(f"captured {args.seeds} seeds; {len(objects)} distinct observations")
    return 0

def write_random_results(path, args, version, commit, rows):
    counts = {key: sum(row["verdict"] == key for row in rows)
              for key in ("match", "mismatch", "unstable", "not applicable")}
    grouped = []
    for row in rows:
        if row["verdict"] == "match":
            grouped.append(row)
            continue
        key = (tuple(row["commands"]), row["request"], tuple(row["differences"]))
        existing = next((item for item in grouped if item.get("key") == key), None)
        if existing:
            existing["seeds"].append(row["seed"])
        else:
            grouped.append({**row, "key": key, "seeds": [row["seed"]]})
    rules = load_rules()
    lines = [
        "# Generated by contrib/sway-ipc-run random"
        + ("." if args.generator == "v1" else f" --generator {args.generator}."),
        "# One row is one seed. Mismatches show the shortest captured prefix ending at",
        "# the first divergent request; identical reproducers are grouped by seed.", "",
        "[run]", f"compositor = {toml_string(args.compositor)}",
        f"version = {toml_string(version)}", f"commit = {toml_string(commit)}",
        provenance.run_line(Path(path), args.compositor),
        f"date = {toml_string(datetime.date.today().isoformat())}",
        'normalization = "sway-ipc/normalize.toml"',
        "normalization_rules = [" + ", ".join(toml_string(name) for name in rule_names(rules)) + "]",
        'scenario_isolation = "fresh compositor per seed"',
        *([] if args.generator == "v1" else [f"generator = {toml_string(args.generator)}"]),
        f"seeds = {len(rows)}", f"steps = {args.steps}",
        *[f"{key.replace(' ', '_')} = {counts[key]}" for key in counts], "",
    ]
    for row in grouped:
        lines += ["[[result]]", f"seed = {row['seed']}",
                  f"verdict = {toml_string(row['verdict'])}"]
        if row["verdict"] in ("mismatch", "unstable"):
            lines += ["seeds = [" + ", ".join(str(seed) for seed in row["seeds"]) + "]",
                      f"step = {row['step']}", f"request = {toml_string(row['request'])}",
                      "commands = [" + ", ".join(toml_string(x) for x in row["commands"]) + "]",
                      "differences = [" + ", ".join(toml_string(x) for x in row["differences"]) + "]"]
        lines.append("")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines))
    print("; ".join(f"{key}: {value}" for key, value in counts.items()))
    return bool(counts["mismatch"])

def selected_random_sequences(manifest, seeds):
    sequences = manifest["sequences"]
    if seeds is None:
        return sequences
    try:
        selected = [int(seed) for seed in seeds.split(",")]
    except ValueError as error:
        raise RuntimeError("--seeds must be a comma-separated list of seed numbers") from error
    by_seed = {sequence["seed"]: sequence for sequence in sequences}
    unknown = set(selected) - by_seed.keys()
    if unknown:
        raise RuntimeError("unknown random seeds: " + ", ".join(map(str, sorted(unknown))))
    return [by_seed[seed] for seed in selected]


def random_main(args, parser):
    if args.compositor is None or args.binary is None:
        parser.error("random requires --compositor and --binary")
    if args.capture:
        args.seeds = int(args.seeds or 5)
        return random_capture(args, parser)
    require_clean_binary(args.binary, args.compositor)
    manifest, objects = random_manifest(RANDOM_ROOTS[args.generator])
    args.steps = manifest["steps"]
    args.unstable_seeds = {row["seed"] for row in manifest.get("unstable", [])}
    sequences = selected_random_sequences(manifest, args.seeds)
    rows, rules = [], load_rules()
    with tempfile.TemporaryDirectory(prefix="sio-") as directory:
        return random_replay(args, sequences, objects, rows, rules, Path(directory))


def random_sequence_run(args, sequence, scratch, suffix="", objects=None):
    run_dir = scratch / f"{sequence['seed']}{suffix}"
    shutil.rmtree(run_dir, ignore_errors=True)
    run_dir.mkdir()
    adapter = ADAPTERS[args.compositor](args, run_dir)
    if args.compositor in DIFFERENTIAL_CONFIGS:
        adapter.config_text = DIFFERENTIAL_CONFIGS[args.compositor]
    actual = []
    with open(run_dir / "compositor.log", "w") as log:
        try:
            version_reply = adapter.start(log)
            reply = adapter.command_reply("output * mode --custom 1280x720@60Hz")
            if not reply or not reply[0].get("success"):
                raise RuntimeError(f"could not set random output mode: {reply}")
            for step, text in enumerate(sequence["commands"], 1):
                observation = random_observation(adapter, text)
                actual.append(observation)
                if objects is not None and args.seeds is not None:
                    expected = objects[sequence["observations"][step - 1]]
                    print(json.dumps({"seed": sequence["seed"], "step": step,
                                      "command": text, "expected": expected,
                                      "actual": observation}, sort_keys=True))
        finally:
            adapter.stop()
    shutil.rmtree(run_dir)
    return version_reply, actual


def random_replay(args, sequences, objects, rows, rules, scratch):
    version_reply = None
    for number, sequence in enumerate(sequences, 1):
        version_reply, actual = random_sequence_run(args, sequence, scratch, objects=objects)
        expected = [objects[digest] for digest in sequence["observations"]]
        result = random_result_rows(sequence["seed"], sequence["commands"],
                                    expected, actual, rules)
        if result[0]["verdict"] == "mismatch":
            _, retry = random_sequence_run(args, sequence, scratch, "-retry")
            retried = random_result_rows(sequence["seed"], sequence["commands"],
                                         expected, retry, rules)
            if retried != result or sequence["seed"] in args.unstable_seeds:
                result[0]["verdict"] = "unstable"
        rows += result
        if number % 25 == 0:
            print(f"replayed {number}/{len(sequences)} seeds", flush=True)
    version, _ = ADAPTERS[args.compositor].version_details(version_reply)
    commit = PINS[args.compositor]
    out = args.out or ROOT / "sway-ipc/results" / (
        PINS["snapshot"][args.compositor] + RANDOM_SUFFIXES[args.generator] + ".toml")
    return write_random_results(out, args, version, commit, rows)

def selected_scenarios(names, corpus="state"):
    with open(ROOT / "sway-ipc/scenarios.toml", "rb") as file:
        scenarios = [scenario for scenario in tomllib.load(file)["scenario"]
                     if corpus in scenario.get("corpora", ("state", "events"))]
    if names:
        unknown = set(names) - {item["name"] for item in scenarios}
        if unknown:
            raise RuntimeError("unknown scenarios: " + ", ".join(sorted(unknown)))
        scenarios = [item for item in scenarios if item["name"] in names]
    return scenarios


def toml_string(value):
    return json.dumps(str(value), ensure_ascii=False)


def write_results(path, compositor, version, commit, rows, rules, run_mode,
                  unstable=False):
    difference = "differs" if compositor == "i3" else "mismatch"
    verdicts = ("match", difference, "unstable", "not applicable") if unstable else (
        "match", difference, "not applicable"
    )
    counts = {key: sum(row["verdict"] == key for row in rows) for key in verdicts}
    difference_fields = len({difference_path(item) for row in rows
                             for item in row.get("differences", [])})
    lines = [
        "# Generated by contrib/sway-ipc-run. One row is one IPC request at a",
        "# captured scenario. Difference paths are JSON paths after documented normalization.",
        "# These rows describe where i3's IPC differs from sway's captures; they are not a pass rate." if compositor == "i3" else "# Every sway fixture field applies to this compositor's sway-compatibility claim.",
        "# Always report " + ", ".join(verdicts) + " together.",
        "",
        "[run]",
        f"compositor = {toml_string(compositor)}",
        f"version = {toml_string(version)}",
        f"commit = {toml_string(commit)}",
        provenance.run_line(Path(path), compositor),
        f"date = {toml_string(datetime.date.today().isoformat())}",
        'normalization = "sway-ipc/normalize.toml"',
        "normalization_rules = [" + ", ".join(toml_string(name) for name in rule_names(rules)) + "]",
        f"scenario_isolation = {toml_string(run_mode)}",
        f"difference_fields = {difference_fields}",
        *[f"{key.replace(' ', '_')} = {counts[key]}" for key in verdicts],
        "",
    ]
    for row in rows:
        lines += ["[[result]]", f"scenario = {toml_string(row['scenario'])}", f"request = {toml_string(row['request'])}", f"verdict = {toml_string(row['verdict'])}"]
        if row.get("differences"):
            lines.append("differences = [" + ", ".join(toml_string(item) for item in row["differences"]) + "]")
        if row.get("reason"):
            lines.append(f"reason = {toml_string(row['reason'])}")
        if row.get("adapted"):
            lines.append("adapted = [" + ", ".join(toml_string(item) for item in row["adapted"]) + "]")
        lines.append("")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines))
    return counts, difference_fields


def scenario_main(args, parser):
    if (args.capture or args.capture_events) and args.compositor != "sway":
        parser.error("capture is restricted to sway")
    if args.binary.resolve() == Path(sys.executable).resolve() or not args.binary.exists():
        parser.error("--binary must name an existing compositor")
    require_clean_binary(args.binary, args.compositor)
    scenarios, rules, rows = selected_scenarios(args.scenario, args.corpus), load_rules(), []
    if args.capture_events:
        scenarios = []
    applicability = load_applicability()
    if args.capture_events:
        batches = [[{"outputs": 2}]]
    elif args.fresh_per_scenario:
        batches = [[scenario] for scenario in scenarios]
    else:
        ordinary = [scenario for scenario in scenarios if "outputs" not in scenario]
        batches = ([ordinary] if ordinary else []) + [[scenario] for scenario in scenarios if "outputs" in scenario]
    for batch in batches:
        with tempfile.TemporaryDirectory(prefix="sio-") as directory:
            run_dir = Path(directory)
            adapter = ADAPTERS[args.compositor](args, run_dir, batch[0] if len(batch) == 1 else None)
            with open(run_dir / "compositor.log", "w") as log:
                try:
                    version_reply = adapter.start(log)
                    if args.capture_events:
                        capture_individual_events(adapter)
                        batch = []
                    for scenario in batch:
                        command_replies = []
                        required = set(scenario.get("requires", []))
                        if not required <= adapter.capabilities:
                            if scenario.get("not_applicable"):
                                for action in scenario["actions"]:
                                    kind, value = action.split(":", 1)
                                    if kind == "capture":
                                        for request in (*QUERY_REQUESTS, "commands"):
                                            rows.append({"scenario": value, "request": request,
                                                         "verdict": "not applicable",
                                                         "reason": scenario["reason"]})
                            continue
                        builders = [build for capability, build in (
                            ("xdg-toplevel-size-hints", adapter.fixture_client),
                            ("wlr-foreign-toplevel-management", adapter.foreign_toplevel_client),
                        ) if capability in required]
                        if builders:
                            try:
                                for build in builders:
                                    build()
                            except FixtureUnavailable as error:
                                if os.environ.get("ORACLE_CONTAINER") == "1":
                                    raise RuntimeError(str(error)) from error
                                for action in scenario["actions"]:
                                    kind, value = action.split(":", 1)
                                    if kind == "capture":
                                        requests = (("events",) if args.corpus == "events" else
                                                    (*applicable_requests(args.compositor, applicability), "commands"))
                                        for request in requests:
                                            rows.append({"scenario": value, "request": request,
                                                         "verdict": "not applicable",
                                                         "reason": str(error)})
                                continue
                        adapter.reset()
                        subscription = EventSubscription(adapter.socket) if args.corpus == "events" else None
                        try:
                            for action in scenario["actions"]:
                                kind, value = action.split(":", 1)
                                if kind == "command":
                                    command_replies.append(command_observation(value, adapter.command_reply(value)))
                                elif kind == "step":
                                    command_replies.append(command_observation(value, adapter.command_reply(value)))
                                elif kind == "probe":
                                    fixture_name, text = value.split(":", 1)
                                    actual = adapter.command_reply(text)
                                    fixture = FIXTURES / f"{fixture_name}.command.json"
                                    if args.capture:
                                        fixture.write_text(json.dumps(actual, indent=2, sort_keys=True) + "\n")
                                    expected = json.loads(fixture.read_text())
                                    differences = compare(expected, actual, "command", rules)
                                    verdict = "differs" if args.compositor == "i3" and differences else "mismatch" if differences else "match"
                                    rows.append({"scenario": fixture_name, "request": "command", "verdict": verdict, "differences": differences})
                                elif kind == "window":
                                    command_replies.append(adapter.open_window(value))
                                elif kind == "window_title":
                                    ident, title = value.split("|", 1)
                                    command_replies.append(adapter.open_window(ident, title))
                                elif kind == "hint_window":
                                    ident, *values = value.split("|")
                                    min_width, min_height, max_width, max_height, parent = map(int, values)
                                    command_replies.append(adapter.open_hinted_window(
                                        ident, min_width, min_height, max_width, max_height,
                                        bool(parent),
                                    ))
                                elif kind == "foreign_toplevel":
                                    ident, request = value.split("|", 1)
                                    command_replies.append(adapter.foreign_toplevel_request(ident, request))
                                elif kind == "capture":
                                    time.sleep(0.15)
                                    requests = (("events",) if args.corpus == "events" else
                                                (*applicable_requests(args.compositor, applicability), "commands"))
                                    for request in requests:
                                        actual = (subscription.checkpoint(adapter.socket, f"oracle-{value}")
                                                  if request == "events" else command_replies
                                                  if request == "commands" else ipc(adapter.socket, request))
                                        fixture = FIXTURES / f"{value}.{request}.json"
                                        if args.capture:
                                            fixture.write_text(json.dumps(actual, indent=2, sort_keys=True) + "\n")
                                        expected = json.loads(fixture.read_text())
                                        excluded = []
                                        if args.compositor == "i3" and request != "events":
                                            expected, actual, excluded = i3_protocol_view(expected, actual, request, applicability)
                                        differences = compare(expected, actual, request, rules)
                                        verdict = "differs" if args.compositor == "i3" and differences else "mismatch" if differences else "match"
                                        rows.append({"scenario": value, "request": request, "verdict": verdict, "differences": differences})
                                        if excluded:
                                            source = applicability["i3"][request]["sway_extension_source"]
                                            rows.append({"scenario": value, "request": request, "verdict": "not applicable", "reason": f"sway extension fields: {', '.join(excluded)}; source: {source}"})
                                    if args.compositor == "i3" and args.corpus != "events":
                                        for request in QUERY_REQUESTS:
                                            if request not in requests:
                                                rows.append({"scenario": value, "request": request,
                                                             "verdict": "not applicable",
                                                             "reason": applicability["i3"][request]["reason"]})
                                else:
                                    raise RuntimeError(f"unknown action {kind}")
                        finally:
                            if subscription:
                                subscription.close()
                finally:
                    adapter.stop()
    if hasattr(adapter, "version_details"):
        version, commit = adapter.version_details(version_reply)
    else:
        version = version_reply.get("human_readable", version_reply.get("loaded_config_file_name", "unknown"))
        commit = version_reply.get("commit", "unknown")
    reject_dirty_version(args.compositor, version, commit)
    commit = PINS[args.compositor]
    suffix = "-events" if args.corpus == "events" else ""
    out = args.out or ROOT / "sway-ipc/results" / f"{PINS['snapshot'][args.compositor]}{suffix}.toml"
    run_mode = "fresh compositor per scenario" if args.fresh_per_scenario else "sequential, with output-count scenarios isolated"
    counts, difference_fields = write_results(out, args.compositor, version, commit, rows, rules, run_mode)
    print("; ".join([*(f"{key}: {counts[key]}" for key in counts),
                     f"difference fields: {difference_fields}"]))
    return bool(counts.get("mismatch", 0))


def fuzz_result_path(compositor, corpus):
    return ROOT / "sway-ipc/results" / f"{PINS['snapshot'][compositor]}-{corpus}.toml"


def write_fuzz_results(path, compositor, corpus, rows, seed, budget):
    difference = "differs" if compositor == "i3" else "mismatch"
    verdicts = ("match", difference, "not applicable", "crash", "hang")
    counts = {verdict: sum(row["verdict"] == verdict for row in rows)
              for verdict in verdicts}
    lines = [
        f"# Generated by contrib/sway-ipc-run {corpus}.",
        "# Crash and hang are compositor-health verdicts, not mismatches.",
        "# Always report every verdict count together.", "", "[run]",
        f"compositor = {toml_string(compositor)}",
        f"version = {toml_string(rows[0]['version'])}",
        f"commit = {toml_string(PINS[compositor])}",
        provenance.run_line(Path(path), compositor),
        f"date = {toml_string(datetime.date.today().isoformat())}",
        f"corpus = {toml_string(corpus)}", f"seed = {seed}",
        f"budget = {toml_string(budget)}", f"cases = {len(rows)}",
        *[f"{key.replace(' ', '_')} = {counts[key]}" for key in verdicts], "",
    ]
    for row in rows:
        lines += ["[[result]]", f"case = {toml_string(row['case'])}",
                  f"verdict = {toml_string(row['verdict'])}"]
        if row.get("reason"):
            lines.append(f"reason = {toml_string(row['reason'])}")
        if row.get("expected") != row.get("actual"):
            lines += [f"expected = {toml_string(json.dumps(row.get('expected'), ensure_ascii=False, sort_keys=True))}",
                      f"actual = {toml_string(json.dumps(row.get('actual'), ensure_ascii=False, sort_keys=True))}"]
        lines.append("")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines))
    print("; ".join(f"{key}: {counts[key]}" for key in verdicts))
    return bool(counts[difference] or counts["crash"] or counts["hang"])


def fuzz_not_applicable(compositor, corpus, case):
    if compositor != "i3":
        return None
    for rule in load_applicability()["i3"].get("fuzz", []):
        if rule["corpus"] == corpus and case in rule["cases"]:
            return (f"{rule['reason']}; i3 source: {rule['i3_source']}; "
                    f"sway extension source: {rule['sway_extension_source']}")
    return None


def fuzz_cases(args):
    variants_per_family, wire_limit = FUZZ_BUDGETS[args.budget]
    if args.mode == "command-fuzz":
        cases = command_fuzz_cases(args.seed)
        if variants_per_family is not None:
            fixed = [(name, command) for name, command in cases
                     if not name.startswith("family-")]
            selected = []
            for family in json.loads(COMMAND_FAMILIES.read_text())["families"]:
                prefix = f"family-{family['name']}-"
                selected += [(name, command) for name, command in cases
                             if name.startswith(prefix)][:variants_per_family]
            cases = fixed + selected
        return [{"name": name, "command": text} for name, text in cases]
    return wire_fuzz_cases()[:wire_limit]


def fuzz_main(args, parser):
    if args.compositor is None or args.binary is None:
        parser.error(f"{args.mode} requires --compositor and --binary")
    if args.capture and args.compositor != "sway":
        parser.error("fuzz capture is restricted to sway")
    require_clean_binary(args.binary, args.compositor)
    corpus = args.mode
    fixture_path = FUZZ_FIXTURES / f"{corpus}.json"
    cases = fuzz_cases(args)
    if args.capture:
        # Capture the larger corpus once; CI snapshots replay its deterministic prefix.
        original_budget = args.budget
        args.budget = "local"
        cases = fuzz_cases(args)
        args.budget = original_budget
    expected_by_name = {}
    if not args.capture:
        fixture = json.loads(fixture_path.read_text())
        fixture_cases = {row["case"]: row for row in fixture["cases"]}
        expected_by_name = {name: row["observation"] for name, row in fixture_cases.items()}
        cases = [case for case in cases if case["name"] in fixture_cases]
    captured, rows = [], []
    for case in cases:
        with tempfile.TemporaryDirectory(prefix="sio-") as directory:
            adapter = ADAPTERS[args.compositor](args, Path(directory))
            with open(Path(directory) / "compositor.log", "w") as log:
                try:
                    version_reply = adapter.start(log)
                    version, _ = adapter.version_details(version_reply)
                    if corpus == "command-fuzz":
                        before = {kind: ipc(adapter.socket, kind)
                                  for kind in ("tree", "workspaces", "outputs")}
                        try:
                            reply = adapter.command_reply(case["command"])
                            observation = {"outcome": "reply", "reply": reply}
                        except socket.timeout:
                            observation = {"outcome": "timeout"}
                        except (OSError, RuntimeError, ValueError) as error:
                            observation = {"outcome": "error", "error": type(error).__name__}
                        time.sleep(0.03)
                        health = subprocess_health(adapter)
                        if health == "healthy":
                            after = {kind: ipc(adapter.socket, kind)
                                     for kind in ("tree", "workspaces", "outputs")}
                            observation["state_changed"] = before != after
                    else:
                        observation = wire_observation(adapter.socket, case)
                        health = subprocess_health(adapter)
                finally:
                    adapter.stop()
        if args.capture:
            captured.append({"case": case["name"], "input":
                             case.get("command", case.get("data", b"").hex()),
                             "observation": observation})
            continue
        expected = expected_by_name[case["name"]]
        reason = fuzz_not_applicable(args.compositor, corpus, case["name"])
        verdict = health if health != "healthy" else (
            "not applicable" if reason else "match" if observation == expected else
            "differs" if args.compositor == "i3" else "mismatch")
        rows.append({"case": case["name"], "verdict": verdict,
                     "expected": expected, "actual": observation,
                     "reason": reason, "version": version})
    if args.capture:
        FUZZ_FIXTURES.mkdir(parents=True, exist_ok=True)
        fixture_path.write_text(json.dumps({"seed": args.seed, "cases": captured},
                                           indent=2, ensure_ascii=False, sort_keys=True) + "\n")
        print(f"captured {len(captured)} {corpus} cases from sway")
        return 0
    out = args.out or fuzz_result_path(args.compositor, corpus)
    return write_fuzz_results(out, args.compositor, corpus, rows, args.seed, args.budget)


def fuzz_self_test():
    assert command_fuzz_cases(7) == command_fuzz_cases(7)
    assert command_fuzz_cases(7) != command_fuzz_cases(8)
    names = {name for name, _ in command_fuzz_cases()}
    assert {"bad-criteria-open", "resize-px", "resize-ppt", "mixed-chain",
            "unicode", "very-long"} <= names
    families = json.loads(COMMAND_FAMILIES.read_text())["families"]
    assert len(families) == len({family["name"] for family in families})
    assert all(any(name.startswith(f"family-{family['name']}-") for name in names)
               for family in families)
    assert all(sum(name.startswith(f"family-{family['name']}-") for name in names) >=
               (3 if family["name"] == "exit" else 5) for family in families)
    ci = argparse.Namespace(mode="command-fuzz", budget="ci", seed=0)
    ci_names = {case["name"] for case in fuzz_cases(ci)}
    assert all(sum(name.startswith(f"family-{family['name']}-") for name in ci_names) == 2
               for family in families)
    assert len(wire_fuzz_cases()) == FUZZ_BUDGETS["local"][1]
    assert {case["name"] for case in wire_fuzz_cases()} >= {
        "bad-magic", "truncated-header", "oversized-length", "unknown-type",
        "subscribe-invalid-json", "command-invalid-json", "many-clients",
    }
    assert fuzz_not_applicable("i3", "command-fuzz", "bad-criteria-open")
    assert not fuzz_not_applicable("i3", "command-fuzz", "unknown-command")
    assert not fuzz_not_applicable("sway", "command-fuzz", "bad-criteria-open")
    manifest = {"sequences": [{"seed": 1}, {"seed": 2}, {"seed": 3}]}
    assert selected_random_sequences(manifest, None) == manifest["sequences"]
    assert selected_random_sequences(manifest, "3,1") == [
        manifest["sequences"][2], manifest["sequences"][0]
    ]
    try:
        selected_random_sequences(manifest, "4")
    except RuntimeError as error:
        assert str(error) == "unknown random seeds: 4"
    else:
        raise AssertionError("unknown random seed was accepted")
    with tempfile.TemporaryDirectory(prefix="sio-") as directory:
        adapter = Adapter(argparse.Namespace(timeout=1), Path(directory))
        old_container = os.environ.get("ORACLE_CONTAINER")
        os.environ["ORACLE_CONTAINER"] = "1"
        try:
            with open(Path(directory) / "compositor.log", "w") as log:
                try:
                    adapter.start_process(["sh", "-c", "echo diagnostic-marker; exit 101"], log)
                except RuntimeError as error:
                    assert "compositor exited with 101\ndiagnostic-marker" in str(error)
                else:
                    raise AssertionError("failed compositor start was accepted")
        finally:
            if old_container is None:
                os.environ.pop("ORACLE_CONTAINER", None)
            else:
                os.environ["ORACLE_CONTAINER"] = old_container
    print("sway IPC fuzz self-test passed")
    return 0


def write_differential_results(path, args, rows):
    counts = {"match": sum(row["verdict"] == "match" for row in rows),
              "mismatch": sum(row["verdict"] == "mismatch" for row in rows)}
    rules = load_rules()
    difference_fields = len({difference_path(item) for row in rows
                             for item in row.get("differences", [])})
    grouped = []
    for row in rows:
        if row["verdict"] == "match":
            grouped.append(row)
            continue
        key = (tuple(row["commands"]), row["request"], tuple(row["differences"]))
        existing = next((item for item in grouped if item.get("key") == key), None)
        if existing:
            existing["seeds"].append(row["seed"])
        else:
            grouped.append({**row, "key": key, "seeds": [row["seed"]]})
    lines = [
        "# Generated by contrib/sway-ipc-run differential.",
        "# One row is one seed; match and mismatch counts are always shown together.",
        "# Mismatches contain delta-debugged reproducers and require triage.", "",
        "[run]", f"a = {toml_string(args.a)}", f"b = {toml_string(args.b)}",
        f"seed_start = {args.seed}", f"seed_end = {args.seed + len(rows) - 1}",
        f"generator = {toml_string(args.generator)}",
        f"steps = {args.steps}", f"seeds = {len(rows)}",
        f"a_commit = {toml_string(PINS[args.a])}",
        f"b_commit = {toml_string(PINS[args.b])}",
        f"date = {toml_string(datetime.date.today().isoformat())}",
        'normalization = "sway-ipc/normalize.toml"',
        "normalization_rules = [" + ", ".join(toml_string(name) for name in rule_names(rules)) + "]",
        f"difference_fields = {difference_fields}",
        f"match = {counts['match']}", f"mismatch = {counts['mismatch']}", "",
    ]
    for row in grouped:
        lines += ["[[result]]", f"seed = {row['seed']}",
                  f"verdict = {toml_string(row['verdict'])}"]
        if row["verdict"] == "mismatch":
            lines += ["seeds = [" + ", ".join(str(seed) for seed in row["seeds"]) + "]",
                      f"step = {row['step']}", f"request = {toml_string(row['request'])}",
                      "commands = [" + ", ".join(toml_string(x) for x in row["commands"]) + "]",
                      "differences = [" + ", ".join(toml_string(x) for x in row["differences"]) + "]",
                      f"scenario = {toml_string(row['scenario'])}"]
        lines.append("")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines))
    print(f"match: {counts['match']}; mismatch: {counts['mismatch']}; "
          f"difference fields: {difference_fields}")
    return bool(counts["mismatch"])


def differential_main(args):
    if args.a_binary is None or args.b_binary is None:
        raise RuntimeError("differential requires --a-binary and --b-binary")
    require_clean_binary(args.a_binary, args.a)
    require_clean_binary(args.b_binary, args.b)
    rows = []
    for seed in range(args.seed, args.seed + args.seeds):
        commands = GENERATORS[args.generator](seed, args.steps)
        divergence, _ = differential_once(args, commands)
        if divergence is None:
            rows.append({"seed": seed, "verdict": "match"})
            continue
        def reproduces(candidate):
            found, _ = differential_once(args, candidate)
            return found is not None
        minimal = minimize_commands(commands[:divergence["step"]], reproduces)
        final, _ = differential_once(args, minimal, keep_state=True)
        if final is None:
            raise RuntimeError(f"seed {seed} stopped reproducing during shrink")
        scenario = f"differential_seed_{seed}"
        if args.save_scenarios:
            scenario = append_regression_scenario(seed, minimal, final["sway_state"])
        rows.append({"seed": seed, "verdict": "mismatch", "commands": minimal,
                     "scenario": scenario, **{k: final[k] for k in
                     ("step", "request", "differences")}})
    if not args.out:
        raise RuntimeError("differential is a developer tool: pass --out outside the repository")
    out = Path(args.out)
    return write_differential_results(out, args, rows)


def main():
    parser = argparse.ArgumentParser(
        description="Run, capture, or compare data-driven sway IPC scenarios."
    )
    parser.add_argument("mode", nargs="?", choices=("scenarios", "differential", "i3-derived", "random", "command-fuzz", "wire-fuzz", "fuzz-self-test"), default="scenarios")
    parser.add_argument("--compositor", choices=ADAPTERS)
    parser.add_argument("--binary", type=Path)
    parser.add_argument("--scenario", action="append")
    parser.add_argument("--out", type=Path)
    parser.add_argument("--capture", action="store_true", help="replace selected sway fixtures")
    parser.add_argument("--corpus", choices=("state", "events"), default="state")
    parser.add_argument("--capture-events", action="store_true", help="replace individual sway event fixtures")
    parser.add_argument("--command-logs", type=Path, help="directory of i3-suite *.commands.jsonl files")
    parser.add_argument("--fresh-per-scenario", action=argparse.BooleanOptionalAction,
                        default=True, help="restart the compositor before each scenario (default: enabled)")
    parser.add_argument("--timeout", type=int, default=60)
    parser.add_argument("--a", choices=ADAPTERS, default="sway")
    parser.add_argument("--b", choices=ADAPTERS, default="swayward")
    parser.add_argument("--a-binary", type=Path)
    parser.add_argument("--b-binary", type=Path)
    parser.add_argument("--seed", type=int, default=0)
    parser.add_argument("--seeds", help="seed count, or random replay seed numbers separated by commas")
    parser.add_argument("--steps", type=int, default=10)
    parser.add_argument("--generator", choices=GENERATORS, default="v1",
                        help="random/differential command generator: v1 (sway-ipc/random) or "
                             "v2 (sway-ipc/random-v2, widened vocabulary)")
    parser.add_argument("--budget", choices=FUZZ_BUDGETS, default="ci",
                        help="fuzz case budget (ci uses two generated variants per command family)")
    parser.add_argument("--save-scenarios", action="store_true",
                        help="save minimized mismatches as sway-captured scenarios")
    parser.add_argument("--triage", default="untriaged",
                        choices=("untriaged", "swayward bug", "documented deviation", "harness issue"))
    parser.add_argument("--finding", help="task ID or documented deviation name")
    parser.add_argument("--source", help="source citation supporting the triage")
    args = parser.parse_args()
    if args.mode == "fuzz-self-test":
        return fuzz_self_test()
    if args.mode in ("command-fuzz", "wire-fuzz"):
        return fuzz_main(args, parser)
    if args.mode == "differential":
        args.seeds = int(args.seeds or 5)
        return differential_main(args)
    if args.mode == "i3-derived":
        return i3_derived_main(args, parser)
    if args.mode == "random":
        return random_main(args, parser)
    if args.compositor is None or args.binary is None:
        parser.error("scenarios requires --compositor and --binary")
    return scenario_main(args, parser)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, ValueError) as error:
        print(f"sway-ipc-run: {error}", file=sys.stderr)
        raise SystemExit(2)
