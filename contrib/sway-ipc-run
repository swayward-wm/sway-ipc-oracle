        focus = initial_fake_focus(self.scenario)
        outputs = (
            f'output "{fake_output_name("headless", index, len(output_layout))}" '
            f'{{ mode custom=true "{width}x{height}@60"; position x={x} y={y}; scale 1;'
            + (' focus-at-startup;' if index == focus else '') + ' }\n'
            for index, (width, height, x, y, _primary) in enumerate(output_layout)
        ) if output_layout else (
            f'output "headless-{number}" {{ mode custom=true "1270x1408@60"; scale 1; }}\n'
            for number in range(1, self.scenario.get("outputs", 1) + 1)
        )
        assignments = "".join(
            f'workspace {json.dumps(match[1])} {{ sway-output-assignment '
            + " ".join(json.dumps(self.translate_command(name)) for name in match[2].split()) + "; }\n"
            for line in self.scenario.get("workspace_outputs", [])
            if (match := re.fullmatch(r"workspace\s+(.+?)\s+output\s+(.+)", line))
        )
