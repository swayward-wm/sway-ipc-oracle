def rule_names(rules):
    names = []
    for value in rules.values():
        entries = value if isinstance(value, list) else [value]
        names.extend(entry["name"] for entry in entries
                     if isinstance(entry, dict) and "name" in entry)
    return names


def tree_field_rules(rules, field, action=None):
    return [rule for rule in rules["tree_field_rule"]
            if rule["field"] == field and (action is None or rule["action"] == action)]


def rule_matches(rule, value, under_floating=False, under_hidden=False):
    def matches(key, expected):
        if key == "under_floating":
            return under_floating == expected
        if key == "under_hidden_scratchpad":
            return under_hidden == expected
        return value.get(key) == expected
    return all(matches(key, expected) for key, expected in rule.get("selector", {}).items())


def tree_context(value, under_floating, under_hidden, in_scratch):
    """Context flags for `value`'s children: below a floating root, and below a
    floating root that sits in sway's synthetic `__i3_scratch` workspace."""
    in_scratch = in_scratch or (value.get("type") == "workspace"
                                and value.get("name") == "__i3_scratch")
    floating_root = value.get("type") == "floating_con"
    return (under_floating or floating_root,
            under_hidden or (floating_root and in_scratch),
            in_scratch)


