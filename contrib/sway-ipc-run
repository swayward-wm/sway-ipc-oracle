        if "[" in probe:
            candidates += [
                ("criteria-quote", re.sub(r"\[[^]]*]", '[app_id="unterminated]', probe, count=1)),
                ("criteria-value", re.sub(r"\[[^]]*]", "[app_id=]", probe, count=1)),
