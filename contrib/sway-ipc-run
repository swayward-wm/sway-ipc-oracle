def recv_wire_reply(stream):
    header = recv_exact(stream, 14)
    length, reply_type = struct.unpack("=II", header[6:])
    body = recv_exact(stream, length)
    try:
        payload = json.loads(body)
    except (UnicodeDecodeError, json.JSONDecodeError):
        payload = {"raw_hex": body.hex()}
    if reply_type == TYPES["version"] and isinstance(payload, dict):
        # Version values name the build and config path; framing is what this corpus tests.
        payload = {"keys": sorted(payload)}
    return {"magic": header[:6].decode(errors="backslashreplace"),
            "type": reply_type, "payload": payload}


def wire_observation(sock_path, case):
    if "clients" in case:
        streams = []
        try:
            for _ in range(case["clients"]):
                stream = socket.socket(socket.AF_UNIX)
                stream.settimeout(2)
                deadline = time.monotonic() + 2
                while True:
                    try:
                        stream.connect(os.fspath(sock_path))
                        break
                    except BlockingIOError:
                        # Python does not retry EAGAIN from a full Unix listen backlog.
                        if time.monotonic() > deadline:
                            raise socket.timeout("listen backlog stayed full")
                        time.sleep(0.01)
                stream.sendall(MAGIC + struct.pack("=II", 0, TYPES["version"]))
                streams.append(stream)
            replies = sum(recv_wire_reply(stream)["type"] == TYPES["version"]
                          for stream in streams)
            return {"outcome": "reply", "clients": len(streams), "replies": replies}
        except (ConnectionError, OSError, RuntimeError, socket.timeout) as error:
            return {"outcome": "error", "error": type(error).__name__}
        finally:
            for stream in streams:
                stream.close()
    try:
        with socket.socket(socket.AF_UNIX) as stream:
            stream.settimeout(2)
            stream.connect(os.fspath(sock_path))
            stream.sendall(case["data"])
            if case.get("shutdown"):
                stream.shutdown(socket.SHUT_WR)
            replies = [recv_wire_reply(stream) for _ in range(case.get("replies", 1))]
            return {"outcome": "reply", "replies": replies}
    except socket.timeout:
        return {"outcome": "timeout"}
    except (BrokenPipeError, ConnectionResetError, RuntimeError):
        return {"outcome": "disconnect"}
    except OSError as error:
        return {"outcome": "error", "error": type(error).__name__}


def subprocess_health(adapter):
    if adapter.process.poll() is not None:
        return "crash"
    try:
        ipc(adapter.socket, "version")
    except socket.timeout:
        return "hang"
    except (OSError, RuntimeError, ValueError):
        return "crash" if adapter.process.poll() is not None else "hang"
    return "healthy"


def subscribed_event(sock_path, family, trigger):
    subscription = EventSubscription(sock_path, (family,))
    trigger()
    try:
        events = subscription.checkpoint(sock_path, "individual-event-barrier")
    finally:
        subscription.close()
    if not events:
        raise RuntimeError(f"expected {family} event")
    return events[0]


def command(sock_path, text):
    reply = ipc(sock_path, "command", text)
    if not isinstance(reply, list) or not all(item.get("success") for item in reply):
        raise RuntimeError(f"command failed: {text}: {reply}")


def fixture_window_count(value):
    if not isinstance(value, dict):
        return 0
    identity = value.get("app_id") or (value.get("window_properties") or {}).get("instance", "")
    return int(str(identity).startswith("fixture-")) + sum(
        fixture_window_count(child)
        for key in ("nodes", "floating_nodes")
        for child in value.get(key, [])
    )


def wait_for(predicate, message, seconds=8):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        value = predicate()
        if value:
            return value
        time.sleep(0.05)
    raise RuntimeError(f"timed out waiting for {message}")


def marked_processes(marker):
    needle = f"{RUN_MARKER}={marker}".encode()
    found = []
    for path in Path("/proc").glob("[0-9]*/environ"):
        try:
            if needle in path.read_bytes().split(b"\0"):
                found.append(int(path.parent.name))
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            pass
    return found


def reap_marked_processes(marker, grace=0.5):
    for pid in marked_processes(marker):
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    deadline = time.monotonic() + grace
    while time.monotonic() < deadline and marked_processes(marker):
        time.sleep(0.05)
    for pid in marked_processes(marker):
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass


