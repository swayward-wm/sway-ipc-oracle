        return translate_fake_outputs(text, "headless", fake_output_count(self.scenario))

    @staticmethod
    def version_details(reply):
        version = reply.get("human_readable", "unknown")
        commit = next((part.rsplit("g", 1)[-1].rstrip(")") for part in version.split() if "-g" in part), None)
        if commit is None:
            commit = next((part.strip("()") for part in version.split()
                           if re.fullmatch(r"\(?[0-9a-f]{8,40}\)?", part)), "unknown")
        return version, commit

    def start(self, log):
        config = self.run_dir / self.config_name
        config.write_text(self.rendered_config())
        self.env.update({"WLR_HEADLESS_OUTPUTS": str(self.scenario.get("outputs", 1)), "SWAYSOCK": str(self.socket), "I3SOCK": str(self.socket), "XDG_RUNTIME_DIR": str(self.run_dir)})
        self.start_process([str(self.args.binary), "-c", str(config)], log)
        version = self.check_started_build(ipc(self.socket, "version"))
        self.display = wait_for(self.find_display, "private Wayland socket")
        return version


class I3Adapter(Adapter):
    def start(self, log):
        if not shutil.which("Xvfb") or not shutil.which("xterm"):
            raise RuntimeError("i3 adapter requires Xvfb and xterm")
        display_number = next((number for number in range(200, 700) if not Path(f"/tmp/.X11-unix/X{number}").exists()), None)
        if display_number is None:
            raise RuntimeError("no private X display number available")
        self.display = f":{display_number}"
        config = self.run_dir / "config"
        output_layout = self.scenario.get("output_layout", [])
        fake_outputs = ""
        if output_layout:
            entries = [
                f"{width}x{height}+{x}+{y}" + ("P" if primary else "")
                for width, height, x, y, primary in output_layout
            ]
            fake_outputs = "fake-outputs " + ",".join(entries) + "\n"
        assignments = "\n".join(self.scenario.get("workspace_outputs", []))
        config.write_text(
            f"font pango:monospace 10\nipc-socket {self.socket}\ndefault_border normal 2\n"
            f"{fake_outputs}{assignments}\n"
        )
        self.env["DISPLAY"] = self.display
        script = f'exec Xvfb {self.display} -screen 0 1270x1408x24 & xvfb=$!; trap "kill $xvfb" EXIT; for i in $(seq 1 100); do [ -S /tmp/.X11-unix/X{display_number} ] && break; sleep .05; done; {self.args.binary} -c {config}'
        self.start_process(["sh", "-c", script], log)
        return ipc(self.socket, "version")

    @staticmethod
    def version_details(reply):
        version = reply.get("human_readable", "unknown")
        commit = version.rsplit("g", 1)[-1] if "-g" in version else "unknown"
        return version, commit

    def command_reply(self, text):
        reply = ipc(self.socket, "command", text.replace("app_id=", "instance="))
        self.reap_children()
        return reply

    def reset(self):
        reply = ipc(self.socket, "command", '[instance="^fixture-"] kill')
        if not isinstance(reply, list) or not all(item.get("success") or item.get("error") == "No matching node." for item in reply):
            raise RuntimeError(f"fixture cleanup failed: {reply}")
        wait_for(lambda: fixture_window_count(ipc(self.socket, "tree")) == 0, "fixture windows to close")
        self.run_command("workspace fixture-reset")
        self.run_command("workspace 1")

    def open_window(self, ident, title=None):
        before = fixture_window_count(ipc(self.socket, "tree"))
        title = title or ident
        text = f"exec --no-startup-id xterm -name {shlex.quote(ident)} -title {shlex.quote(title)}"
        self.clients.append(subprocess.Popen(
            ["xterm", "-name", ident, "-title", title], env=self.env,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        ))
        reply = [{"success": True}]
        wait_for(lambda: fixture_window_count(ipc(self.socket, "tree")) == before + 1, ident)
        self.reap_children()
        return command_observation(text, reply)


