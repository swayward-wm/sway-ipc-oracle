def applicable_requests(compositor, applicability):
    if compositor != "i3":
        return QUERY_REQUESTS
    return tuple(request for request in QUERY_REQUESTS
                 if applicability["i3"][request].get("applicable", True))


def i3_protocol_view(expected, actual, request, applicability):
    if request == "commands":
        left, right, excluded = [], [], set()
        for expected_item, actual_item in zip(expected, actual):
            expected_reply, actual_reply, item_excluded = i3_protocol_view(
                expected_item["reply"], actual_item["reply"], "command", applicability
            )
            left.append({"command": expected_item["command"], "reply": expected_reply})
            right.append({"command": actual_item["command"], "reply": actual_reply})
            excluded.update(item_excluded)
        return left, right, sorted(excluded)
    fields = applicability["i3"][request].get("fields")
    if fields is None:
        return copy.deepcopy(expected), copy.deepcopy(actual), []
    fields = set(fields)
    excluded = set()

    def project(value, collect=False, protocol_object=True):
        if isinstance(value, dict):
            if not protocol_object:
                return copy.deepcopy(value)
            if collect:
                excluded.update(value.keys() - fields)
            return {
                key: project(child, collect, key in ("nodes", "floating_nodes"))
                for key, child in value.items()
                if key in fields
            }
        if isinstance(value, list):
            return [project(child, collect, protocol_object) for child in value]
        return value

    return project(expected, True), project(actual), sorted(excluded)


def shape_view(value):
    if isinstance(value, dict):
        return {key: shape_view(child) for key, child in value.items()}
    if isinstance(value, list):
        return [shape_view(child) for child in value]
    if value is None:
        return "null"
    if isinstance(value, bool):
        return "boolean"
    if isinstance(value, (int, float)):
        return "number"
    return "string"


