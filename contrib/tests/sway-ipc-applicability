#!/usr/bin/env python3
"""Check that i3 runs compare only the shared i3 IPC schema."""

import copy
import importlib.machinery
from pathlib import Path

root = Path(__file__).resolve().parents[2]
runner = importlib.machinery.SourceFileLoader(
    "sway_ipc_run", str(root / "contrib/sway-ipc-run")
).load_module()
rules = runner.load_applicability()
scenarios = {item["name"]: item for item in runner.selected_scenarios(None)}
assert scenarios["disabled_output_evacuation"]["requires"] == ["sway-command-language"]
assert scenarios["disabled_output_evacuation"]["not_applicable"] is True
assert scenarios["urgent_via_command"]["not_applicable"] is True
assert scenarios["command_coverage"]["requires"] == ["sway-command-language"]
assert scenarios["command_coverage"]["not_applicable"] is True
assert runner.SwayAdapter.capabilities == {
    "sway-command-language", "xdg-toplevel-size-hints", "wlr-foreign-toplevel-management",
}
assert runner.SwaywardAdapter.capabilities == {
    "sway-command-language", "xdg-toplevel-size-hints", "wlr-foreign-toplevel-management",
}
assert not runner.I3Adapter.capabilities
assert "sway/sway/commands/output/disable.c" in scenarios["disabled_output_evacuation"]["reason"]
assert runner.QUERY_REQUESTS == (
    "tree", "workspaces", "outputs", "marks", "binding_modes",
    "binding_state", "seats", "inputs", "version",
)
assert rules["i3"]["seats"]["applicable"] is False
assert rules["i3"]["inputs"]["applicable"] is False
assert runner.applicable_requests("i3", rules) == (
    "tree", "workspaces", "outputs", "marks", "binding_modes",
    "binding_state", "version",
)
assert runner.applicable_requests("sway", rules) == runner.QUERY_REQUESTS
assert rules["i3"]["marks"]["fields"] == []
assert runner.shape_view({"major": 1, "loaded_config_file_name": None}) == {
    "major": "number", "loaded_config_file_name": "null",
}

sway_version = {
    "major": 1,
    "minor": 12,
    "patch": 0,
    "human_readable": "1.12-88869399 (Sep 25 2026, branch 'HEAD')",
    "loaded_config_file_name": "/example/sway/config",
    "variant": "sway",
}
swayward_version = {
    "major": 26,
    "minor": 4,
    "patch": 0,
    "human_readable": "swayward beta0-dev (v26.04-5f4ad1d8)",
    "loaded_config_file_name": "/example/swayward/config.kdl",
    "variant": "swayward",
}
assert runner.compare(sway_version, swayward_version, "version", runner.load_rules()) == []
wrong_identity_type = {**sway_version, "major": "1"}
assert runner.compare(sway_version, wrong_identity_type, "version", runner.load_rules()) == [
    "$version.major: 'number' != 'string'"
]
missing_identity = sway_version.copy()
del missing_identity["loaded_config_file_name"]
assert runner.compare(sway_version, missing_identity, "version", runner.load_rules()) == [
    "$version: keys differ"
]

expected = [{
    "name": "WL-1",
    "active": True,
    "primary": False,
    "current_workspace": "1",
    "rect": {"x": 0, "y": 0, "width": 100, "height": 100},
    "scale": 1.0,
}]
actual = [{
    "name": "xroot-0",
    "active": False,
    "primary": False,
    "current_workspace": None,
    "rect": {"x": 0, "y": 0, "width": 100, "height": 100},
}]
left, right, excluded = runner.i3_protocol_view(expected, actual, "outputs", rules)
assert "scale" not in left[0]
assert left[0]["rect"] == {"x": 0, "y": 0, "width": 100, "height": 100}
assert excluded == ["scale"]
assert set(runner.compare(left, right, "outputs", runner.load_rules())) == {
    "$outputs[0].name: 'WL-1' != 'xroot-0'",
    "$outputs[0].current_workspace: type str != NoneType",
    "$outputs[0].active: True != False",
}

expected_outputs = [
    {"type": "output", "name": "HEADLESS-2", "scale": 1.0},
    {"type": "output", "name": "HEADLESS-1", "scale": 1.25},
]
reordered_outputs = [
    {"type": "output", "name": "headless-1", "scale": 1.25},
    {"type": "output", "name": "headless-2", "scale": 1.0},
]
assert runner.compare(
    expected_outputs, reordered_outputs, "outputs", runner.load_rules()
) == []
wrong_output = copy.deepcopy(reordered_outputs)
wrong_output[0]["scale"] = 2.0
assert runner.compare(
    expected_outputs, wrong_output, "outputs", runner.load_rules()
) == ["$outputs[1].scale: 1.25 != 2.0"]

expected_tree = {
    "id": 1,
    "type": "con",
    "name": "fixture",
    "nodes": [{"id": 3, "nodes": [], "floating_nodes": [], "app_id": "nested"}],
    "floating_nodes": [],
    "app_id": "fixture-1",
    "scratchpad_state": "none",
}
actual_tree = {
    "id": 2,
    "type": "con",
    "name": "fixture",
    "nodes": [],
    "floating_nodes": [],
    "scratchpad_state": "fresh",
}
left, right, excluded = runner.i3_protocol_view(expected_tree, actual_tree, "tree", rules)
assert "app_id" not in left
assert excluded == ["app_id"]
assert "app_id" not in left["nodes"][0]
assert set(runner.compare(left, right, "tree", runner.load_rules())) == {
    "$tree.scratchpad_state: 'none' != 'fresh'",
    "$tree.nodes: length 1 != 0",
}

expected_command = [{"success": False, "parse_error": True, "error": "sway text"}]
actual_command = [{"success": False, "error": "i3 text"}]
left, right, excluded = runner.i3_protocol_view(
    expected_command, actual_command, "command", rules
)
assert left == [{"success": False, "error": "sway text"}]
assert excluded == ["parse_error"]
assert runner.command_observation("focus left", expected_command) == {
    "command": "focus left", "reply": expected_command,
}

calls = []
original_ipc = runner.ipc
runner.ipc = lambda socket, kind, payload: calls.append((socket, kind, payload)) or []
try:
    adapter = object.__new__(runner.I3Adapter)
    adapter.socket = "test.sock"
    adapter.command_reply('[app_id="fixture"] focus')
finally:
    runner.ipc = original_ipc
assert calls == [("test.sock", "command", '[instance="fixture"] focus')]
assert runner.SwaywardAdapter.open_window_command is runner.WaylandAdapter.open_window_command
adapter = object.__new__(runner.WaylandAdapter)
adapter.run_dir = root
original_which = runner.shutil.which
runner.shutil.which = lambda tool: None if tool == "wayland-scanner" else f"/usr/bin/{tool}"
try:
    try:
        adapter.fixture_client()
    except runner.FixtureUnavailable as error:
        assert str(error) == "fixture client unavailable (missing wayland-scanner)"
    else:
        raise AssertionError("missing fixture build tool was accepted")
finally:
    runner.shutil.which = original_which
assert 'mode "resize"' in runner.SwaywardAdapter.config_text
assert runner.SwaywardAdapter.version_details(
    {"human_readable": "swayward beta0-dev (3ff27e06)"}
) == ("swayward beta0-dev (3ff27e06)", "3ff27e06")

sequence = runner.generate_commands(17, 20)
assert sequence == runner.generate_commands(17, 20)
assert sequence != runner.generate_commands(18, 20)
assert len(sequence) == 20
assert all(isinstance(item, str) and item for item in sequence)

original = ["a", "noise-1", "b", "noise-2", "c"]
minimal = runner.minimize_commands(original, lambda items: "a" in items and "c" in items)
assert minimal == ["a", "c"]

objects = {}
digest = runner.store_random_object(objects, {"tree": [], "command": [{"success": True}]})
assert digest == runner.store_random_object(
    objects, {"command": [{"success": True}], "tree": []}
)
assert len(objects) == 1
empty_tree = {
    "type": "root", "rect": {"x": 0, "y": 0, "width": 1, "height": 1},
    "deco_rect": {"x": 0, "y": 0, "width": 0, "height": 0},
    "window_rect": {"x": 0, "y": 0, "width": 0, "height": 0},
    "geometry": {"x": 0, "y": 0, "width": 0, "height": 0},
    "nodes": [], "floating_nodes": [], "focus": [],
}
assert runner.random_result_rows(
    7,
    ["splith", "focus left"],
    [
        {"command": [{"success": True}], "tree": empty_tree, "workspaces": []},
        {"command": [{"success": True}], "tree": empty_tree, "workspaces": []},
    ],
    [
        {"command": [{"success": True}], "tree": empty_tree, "workspaces": []},
        {"command": [{"success": False}], "tree": empty_tree, "workspaces": []},
    ],
    runner.load_rules(),
)[0] == {
    "seed": 7,
    "verdict": "mismatch",
    "step": 2,
    "request": "command",
    "commands": ["splith", "focus left"],
    "differences": ["$command[0].success: True != False"],
}

floating_child = {
    **empty_tree,
    "nodes": [{
        **empty_tree,
        "type": "floating_con",
        "floating": "user_on",
        "percent": 0.4,
        "nodes": [{**empty_tree, "type": "con", "floating": "auto_off", "percent": 0.5}],
    }],
}
floating_child_variant = copy.deepcopy(floating_child)
floating_child_variant["nodes"][0]["nodes"][0]["percent"] = 0.501
assert runner.compare(
    floating_child, floating_child_variant, "tree", runner.load_rules()
) == []
floating_rules = runner.load_rules()
floating_rules["tree_field_rule"] = [
    rule for rule in floating_rules["tree_field_rule"]
    if rule["name"] != "floating-percent-run-variance"
]
normalized_floating = copy.deepcopy(floating_child)
runner.normalize(normalized_floating, floating_rules, "$tree")
assert normalized_floating["nodes"][0]["percent"] == 0.4
assert normalized_floating["nodes"][0]["nodes"][0]["percent"] == runner.NORMAL

print("i3 applicability and differential checks passed")
