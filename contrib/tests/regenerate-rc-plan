#!/usr/bin/env python3
"""Self-test for contrib/regenerate-rc's unit plan, without Podman."""
import argparse
import importlib.machinery
import pathlib
import sys
import tempfile
import tomllib

sys.dont_write_bytecode = True
root = pathlib.Path(__file__).resolve().parents[2]
rc = importlib.machinery.SourceFileLoader("regenerate_rc", str(root / "contrib/regenerate-rc")).load_module()

pins = tomllib.load((root / "pins.toml").open("rb"))
snapshots = dict(pins["snapshot"])
# Plan as if every committed result were pending, so the checks below do not
# depend on what pending.toml lists today (it is empty after a regeneration).
pending = sorted(str(path.relative_to(root)) for oracle in ("i3", "sway-ipc")
                 for path in (root / oracle / "results").glob("*.toml"))
units, unknown = rc.plan_units(snapshots, pending)
names = [unit["name"] for unit in units]

# Every pending result has a unit, and every snapshot compositor has a binary.
assert not unknown, unknown
assert set(pending) <= {unit["result"] for unit in units}, set(pending) - {unit["result"] for unit in units}
assert set(snapshots) <= rc.BINARY.keys(), set(snapshots) - rc.BINARY.keys()

# Units follow pins.toml order after i3, sway and swayward.
compositors = [unit["compositor"] for unit in units if unit["name"].startswith("sway-ipc/")]
expected = [*rc.FIRST, *(c for c in snapshots if c not in rc.FIRST)]
assert compositors == sorted(compositors, key=expected.index), compositors
for compositor in ("swayfx", "scroll", "miracle-wm", "swirl"):
    assert f"sway-ipc/{compositor}/state" in names, (compositor, names)
    assert f"sway-ipc/{compositor}/i3-derived" not in names, compositor

# Each new unit runs its own binary twice; only SwayFX gets the render node.
run = rc.Run(argparse.Namespace(sha="0" * 40, dry_run=True, image="img", trial=None, shards=4))
for unit in units:
    steps = rc.unit_steps(unit, "w", 4)
    if unit["corpus"] != "i3-suite" and unit["name"] != "i3-derived-capture":
        assert len(steps) == 2 and all(rc.BINARY[unit["compositor"]] in step[0] for step in steps), unit
    command = run.podman("true", unit["compositor"])
    assert ("--device" in command) == (unit["compositor"] == "swayfx"), (unit["name"], command)

# Agreement for other sway-ipc units: equal apart from the date line
# (state, events and random: contrib/tests/regenerate-rc-agreement).
with tempfile.TemporaryDirectory() as directory:
    a, b = pathlib.Path(directory, "a"), pathlib.Path(directory, "b")
    a.write_text('date = "1"\nx = 1\n')
    b.write_text('date = "2"\nx = 1\n')
    unit = {"name": "sway-ipc/scroll/wire-fuzz", "compositor": "scroll", "corpus": "wire-fuzz"}
    assert rc.agreement(unit, a, b) == []
    b.write_text('date = "2"\nx = 2\n')
    assert rc.agreement(unit, a, b) == ["-x = 1", "+x = 2"]

print(f"regenerate-rc plan self-test passed ({len(units)} units)")
