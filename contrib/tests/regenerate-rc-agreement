#!/usr/bin/env python3
"""Self-test for contrib/regenerate-rc's state, events and random agreement, with fake runs."""
import importlib.machinery
import pathlib
import sys
import tempfile
import tomllib

sys.dont_write_bytecode = True
root = pathlib.Path(__file__).resolve().parents[2]
sys.path.insert(0, str(root / "contrib"))
rc = importlib.machinery.SourceFileLoader("regenerate_rc", str(root / "contrib/regenerate-rc")).load_module()


def result(rows, date="2026-10-18", version="1"):
    """A sway-ipc-run state result: rows are (scenario, request, verdict)."""
    counts = {key: sum(v.replace(" ", "_") == key for _, _, v in rows)
              for key in ("match", "mismatch", "unstable", "not_applicable")}
    lines = ["# Generated by contrib/sway-ipc-run.", "", "[run]", 'compositor = "scroll"',
             f'version = "{version}"', f'date = "{date}"', "difference_fields = 1",
             *(f"{key} = {value}" for key, value in counts.items()), ""]
    for scenario, request, verdict in rows:
        lines += ["[[result]]", f'scenario = "{scenario}"', f'request = "{request}"', f'verdict = "{verdict}"']
        if verdict == "mismatch":
            lines.append('differences = ["$.x"]')
        lines.append("")
    return "\n".join(lines)


base = [(f"s{n}", "tree", "match") for n in range(40)] + [("m", "tree", "mismatch")]

with tempfile.TemporaryDirectory() as directory:
    a, b = pathlib.Path(directory, "run1.toml"), pathlib.Path(directory, "run2.toml")

    def check(compositor, run1, run2, **extra):
        a.write_text(result(run1))
        b.write_text(result(run2, date="2026-10-19", **extra))
        return rc.scenario_agreement(compositor, a, b)

    # Identical apart from the date: agree, install run1 unchanged.
    problems, flips, text = check("scroll", base, base)
    assert (problems, flips, text) == ([], [], a.read_text()), problems

    # One row flips match <-> mismatch: agree, that row installs unstable, counts follow.
    flipped = [("s3", "tree", "mismatch"), *(row for row in base if row[0] != "s3")]
    problems, flips, text = check("scroll", base, sorted(flipped))
    assert not problems and flips == ["s3.tree#0:match>mismatch"], (problems, flips)
    doc = tomllib.loads(text)
    verdicts = {row["scenario"]: row["verdict"] for row in doc["result"]}
    assert verdicts["s3"] == "unstable" and verdicts["m"] == "mismatch", verdicts
    assert {k: doc["run"][k] for k in ("match", "mismatch", "unstable")} == {
        "match": 39, "mismatch": 1, "unstable": 1}, doc["run"]
    assert doc["run"]["date"] == "2026-10-18"

    # An unstable row in either run stays unstable.
    problems, flips, text = check("scroll", base, [*base[:-1], ("m", "tree", "unstable")])
    assert not problems and [row["verdict"] for row in tomllib.loads(text)["result"]][-1] == "unstable"

    # sway is the reference: any row disagreement fails.
    problems, _, _ = check("sway", base, sorted(flipped))
    assert problems and "reference" in problems[0], problems

    # More than 5% of the rows disagreeing (3 of 41) fails.
    many = [(s, r, "mismatch" if s in ("s1", "s2", "s3") else v) for s, r, v in base]
    problems, _, _ = check("scroll", base, many)
    assert any("cap" in p for p in problems), problems

    # A [run] key other than counts, difference_fields and date fails.
    problems, _, _ = check("scroll", base, base, version="2")
    assert problems == ["[run] version: '1' vs '2'"], problems

    # A row missing from one run without a crash in its scenario fails.
    problems, _, _ = check("scroll", base, base[1:])
    assert problems and "one run only" in problems[0], problems

    # agreement() routes state and events through the same rule.
    unit = {"name": "sway-ipc/scroll/state", "compositor": "scroll", "corpus": "state"}
    a.write_text(result(base))
    b.write_text(result(sorted(flipped)))
    assert rc.agreement(unit, a, b) == []

print("regenerate-rc agreement self-test passed")

def random_result(rows, date="2026-10-18", version="1"):
    """A sway-ipc-run random result: rows are (seed, verdict, reproducer-step)."""
    counts = {key: sum(v == key for _, v, _ in rows) for key in ("match", "mismatch", "unstable")}
    lines = ["# Generated by contrib/sway-ipc-run random.", "", "[run]", 'compositor = "scroll"',
             f'version = "{version}"', f'date = "{date}"', f"seeds = {len(rows)}", "steps = 20",
             *(f"{key} = {value}" for key, value in counts.items()), "not_applicable = 0", ""]
    for seed, verdict, step in rows:
        lines += ["[[result]]", f"seed = {seed}", f'verdict = "{verdict}"']
        if verdict != "match":
            lines += [f"seeds = [{seed}]", f"step = {step}", 'request = "tree"',
                      'commands = ["focus up"]', 'differences = ["$.x"]']
        lines.append("")
    return "\n".join(lines)


seeds = [(n, "match", 0) for n in range(40)] + [(40, "mismatch", 3)]
with tempfile.TemporaryDirectory() as directory:
    a, b = pathlib.Path(directory, "run1.toml"), pathlib.Path(directory, "run2.toml")

    def check_random(compositor, run1, run2, **extra):
        a.write_text(random_result(run1))
        b.write_text(random_result(run2, date="2026-10-19", **extra))
        return rc.random_agreement(compositor, a, b)

    # Equal apart from the date: agree, install run1 unchanged.
    assert check_random("scroll", seeds, seeds) == ([], [], a.read_text())

    # Seed 3 unstable in run1, match in run2: installs unstable, counts follow.
    flipped = [(3, "unstable", 9) if s == 3 else (s, v, st) for s, v, st in seeds]
    problems, flips, text = check_random("scroll", flipped, seeds)
    assert not problems and flips == ["seed3:unstable>match"], (problems, flips)
    doc = tomllib.loads(text)
    assert {k: doc["run"][k] for k in ("match", "mismatch", "unstable")} == {
        "match": 39, "mismatch": 1, "unstable": 1}, doc["run"]
    row = next(r for r in doc["result"] if r["seed"] == 3)
    assert row["verdict"] == "unstable" and row["step"] == 9, row

    # Match in run1, mismatch in run2: unstable with run2's reproducer.
    later = [(3, "mismatch", 7) if s == 3 else (s, v, st) for s, v, st in seeds]
    problems, flips, text = check_random("scroll", seeds, later)
    row = next(r for r in tomllib.loads(text)["result"] if r["seed"] == 3)
    assert not problems and row["verdict"] == "unstable" and row["step"] == 7, (problems, row)

    # sway is the reference: any seed disagreement fails.
    problems, _, _ = check_random("sway", flipped, seeds)
    assert problems and "reference" in problems[0], problems

    # More than 5% of the seeds disagreeing (3 of 41) fails.
    many = [(s, "mismatch", 1) if s in (1, 2, 3) else (s, v, st) for s, v, st in seeds]
    problems, _, _ = check_random("scroll", seeds, many)
    assert any("cap" in p for p in problems), problems

    # A crash in one run only fails; so does a missing seed or another [run] key.
    crashed = [(3, "crash", 0) if s == 3 else (s, v, st) for s, v, st in seeds]
    a.write_text(random_result(seeds))
    b.write_text(random_result(seeds).replace('seed = 3\nverdict = "match"',
                 'seed = 3\nverdict = "crash"\nstep = 2\ncommands = []\nexits = []'))
    problems, _, _ = rc.random_agreement("scroll", a, b)
    assert problems and "crash" in problems[0], problems
    problems, _, _ = check_random("scroll", seeds, seeds[1:])
    assert any("one run only" in p for p in problems), problems
    problems, _, _ = check_random("scroll", seeds, seeds, version="2")
    assert problems == ["[run] version: '1' vs '2'"], problems

    # agreement() routes random through the same rule.
    unit = {"name": "sway-ipc/scroll/random", "compositor": "scroll", "corpus": "random"}
    a.write_text(random_result(flipped))
    b.write_text(random_result(seeds))
    assert rc.agreement(unit, a, b) == []

# A flipped seed that shares a mismatch group's reproducer becomes its own
# unstable row, whether it led the group or not; rows agree with [run].
group = [(n, "mismatch", 3) for n in range(40)]
with tempfile.TemporaryDirectory() as directory:
    a, b = pathlib.Path(directory, "run1.toml"), pathlib.Path(directory, "run2.toml")
    a.write_text(rc.random_text(random_result(group).split("\n[[result]]\n", 1)[0],
                                [{"seed": n, "verdict": "mismatch", "step": 3, "request": "tree",
                                  "commands": ["focus up"], "differences": ["$.x"]} for n in range(40)]))
    assert len(tomllib.loads(a.read_text())["result"]) == 1  # one grouped row
    for flip in (0, 5):
        b.write_text(random_result([(n, "match" if n == flip else v, st) for n, v, st in group],
                                   date="2026-10-19"))
        problems, flips, text = rc.random_agreement("scroll", a, b)
        doc = tomllib.loads(text)
        listed = {seed: row["verdict"] for row in doc["result"] for seed in row.get("seeds", [row["seed"]])}
        assert not problems and flips == [f"seed{flip}:mismatch>match"], (problems, flips)
        assert listed[flip] == "unstable" and sum(v == "unstable" for v in listed.values()) == 1, listed
        assert {k: doc["run"][k] for k in ("mismatch", "unstable")} == {"mismatch": 39, "unstable": 1}

# The installed text keeps sway-ipc-run's layout: rebuilding a committed
# random result from its rows reproduces it byte for byte.
for path in sorted((root / "sway-ipc/results").glob("*-random.toml")):
    source = path.read_text()
    rows = rc.random_seed_rows(tomllib.loads(source))
    rebuilt = rc.random_text(source.split("\n[[result]]\n", 1)[0], [rows[s] for s in sorted(rows)])
    assert rebuilt == source, path

print("regenerate-rc random agreement self-test passed")



# An installed result carries the inputs hash of its committed name, not of
# the run file it was copied from (provenance picks dependencies by name).
import provenance  # noqa: E402

for name in ("sway-ipc/results/swayward-ec03e0af-events.toml",
             "sway-ipc/results/swayward-ec03e0af-random.toml",
             "i3/results/swayward-ec03e0af.toml"):
    committed = root / name
    if not committed.exists():
        continue
    with tempfile.TemporaryDirectory(dir=root / "target" if (root / "target").is_dir() else None) as work:
        run1 = pathlib.Path(work) / "run1.toml"
        run1.write_text(committed.read_text())
        provenance.restamp(run1)
        backup = committed.read_bytes()
        try:
            rc.install_result(run1, committed)
            got = tomllib.loads(committed.read_text())["run"]["inputs"]
            want = provenance.inputs_hash(committed.resolve(), "swayward")
            assert got == want, f"{name}: installed inputs {got[:12]} != {want[:12]}"
        finally:
            committed.write_bytes(backup)
print("regenerate-rc install restamp self-test passed")
