class Process:
    def __init__(self):
        self.code = None

    def poll(self):
        return self.code

    def wait(self, timeout=None):
        if self.code is None:
            raise subprocess.TimeoutExpired("sway", timeout)
        return self.code


class Fake:
    """A sway that dies with exit code `code` at step `die_at`.

    raise_on_death: the dying step raises (connection reset) instead of
    replying first and dying a transaction later. code None: the process
    stays but stops answering IPC.
    """
    def __init__(self, die_at=None, code=1, raise_on_death=True, fail_start=False,
                 fail_alive_at=None):
        self.die_at, self.code, self.raise_on_death = die_at, code, raise_on_death
        self.fail_start, self.fail_alive_at = fail_start, fail_alive_at
        self.process = Process()
        self.socket = Path("/nonexistent/fake.sock")
        self.steps, self.sent, self.stopped, self.dead = 0, [], False, False

    def start(self, log):
        if self.fail_start:
            raise RuntimeError("compositor exited with 1")
        log.write("fake sway started\n")

    def set_differential_mode(self):
        return [{"success": True}]

    def translate_command(self, text):
        return runner.translate_fake_outputs(text, "HEADLESS", 1)

    def stop(self):
        self.stopped = True


def install(fake):
    def adapter(compositor, args, run_dir, scenario=None):
        assert compositor == "sway" and args.unpinned is True
        assert len(str(run_dir / "wayland-1")) < 100
        fake.args = args
        return fake

    def ipc(sock, kind, payload=""):
        if fake.dead:
            raise ConnectionRefusedError(111, "Connection refused")
        return {"tree": TREE, "workspaces": WORKSPACES, "version": {}}[kind]

    def observation(adapter, text):
        assert "@con:" not in text  # resolved before it is executed
        adapter.steps += 1
        adapter.sent.append(text)
        if adapter.fail_alive_at == adapter.steps:
            raise RuntimeError("timed out waiting for generated window")
        if adapter.die_at is not None and adapter.steps >= adapter.die_at:
            adapter.dead = True
            adapter.process.code = adapter.code
            if adapter.raise_on_death:
                raise ConnectionResetError(104, "Connection reset by peer")
        return {"command": [{"success": True}], "tree": TREE, "workspaces": WORKSPACES}

    runner.differential_adapter = adapter
    runner.ipc = ipc
    runner.random_observation = observation
    return fake


def run(fake, commands, log):
    install(fake)
    record = sequence.new_record()
    result = sequence.run_sequence(Path("/bin/true"), None, sequence.Fixed(commands), record, log, 7)
    assert fake.stopped, "adapter not stopped"
    return result, record


# crash_signature: the fixture is an excerpt of a real ASan+UBSan sway log, with non-fatal
# UBSan runtime errors (commands/mode.c) well before the fatal SEGV.
ASAN_LOG = (ROOT / "contrib/tests/fixtures/pr-check-asan.log").read_text()
sig = signature.crash_signature(ASAN_LOG, 1)
assert sig["key"] == "SEGV: view_is_visible < transaction_commit < transaction_commit_pending", sig
assert sig["kind"] == "asan" and len(sig["frames"]) == 3, sig
assert sig["detail"].splitlines()[0].startswith("==13789==ERROR: AddressSanitizer: SEGV")
# Up to 30 lines from the block (the excerpt ends 28 lines after it), no earlier UBSan noise.
assert sig["detail"].splitlines() == ASAN_LOG.splitlines()[-28:], sig["detail"]
assert "SUMMARY: AddressSanitizer: SEGV" in sig["detail"] and "runtime error" not in sig["detail"]
long = ASAN_LOG + "".join(f"after {n}\n" for n in range(10))
assert len(signature.crash_signature(long, 1)["detail"].splitlines()) == 30


def asan_block(pid, bug, frames):
    lines = [f"=={pid}==ERROR: AddressSanitizer: {bug} on address 0x602000000010 (pc 0x1)",
             f"=={pid}==The signal is caused by a READ memory access."]
    lines += [f"    #{n} 0x{n:012x} {f'in {func} ' if func else ''}{path}"
              for n, (func, path) in enumerate(frames)]
    return "\n".join(lines + ["", f"SUMMARY: AddressSanitizer: {bug}", ""])


# Frames differing only in line numbers give the same key; non-sway frames are skipped.
old = asan_block(1, "heap-use-after-free", [
    ("free", "(/lib64/libasan.so.8+0xf4d38)"), ("seat_get_focus", "../sway/input/seat.c:329"),
    ("wl_event_loop_dispatch", "(/lib64/libwayland-server.so.0+0x6811)"),
    ("focus_cmd", "../sway/commands/focus.c:12"), ("execute_command", "/src/sway/commands.c:301"),
    ("main", "../sway/main.c:395")])
new = old.replace("seat.c:329", "seat.c:341").replace("focus.c:12", "focus.c:20")
assert signature.crash_signature(old, 1)["key"] == signature.crash_signature(new, 1)["key"] == \
    "heap-use-after-free: seat_get_focus < focus_cmd < execute_command"
assert signature.crash_signature(old, 1)["frames"] == ["seat_get_focus", "focus_cmd", "execute_command"]

# Two ASan blocks: the last one is the fatal report.
first = asan_block(7, "SEGV", [("view_is_visible", "../sway/tree/view.c:1188")])
last = asan_block(8, "stack-overflow", [("node_get_parent", "../sway/tree/node.c:80")])
sig = signature.crash_signature(f"{first}\nnoise\n{last}", 1)
assert sig["key"] == "stack-overflow: node_get_parent" and sig["detail"].startswith("==8=="), sig

# The bug type stops before variable details.
sized = asan_block(5, "x", [("list_add", "../sway/list.c:9")]).replace(
    "x on address 0x602000000010 (pc 0x1)", "allocation-size-too-big: requested allocation size 0xffff")
assert signature.crash_signature(sized, 1)["key"] == "allocation-size-too-big: list_add"
double = sized.replace("allocation-size-too-big: requested allocation size 0xffff",
                       "attempting double-free on 0x602000000010 in thread T0:")
assert signature.crash_signature(double, 1)["key"] == "attempting double-free: list_add"

# An unsymbolized frame (func None) does not end the stack; later in-sway frames still count.
# The shape of a real ASan run in the oracle image, and a raise in front of three sway frames.
reviewed = asan_block(3, "SEGV", [
    ("sway_fault", "/tmp/x/sway/main.c:2"), (None, " (/tmp/x/libforeign.so+0x39a)"),
    ("foreign_bridge", "/tmp/x/foreign.c:1"), ("container_swap", "/tmp/x/sway/main.c:3"),
    ("cmd_swap", "/tmp/x/sway/main.c:4")])
sig = signature.crash_signature(reviewed, 1)
assert sig["frames"] == ["sway_fault", "container_swap", "cmd_swap"], sig
assert sig["key"] == "SEGV: sway_fault < container_swap < cmd_swap", sig
raised = asan_block(4, "SEGV", [
    ("raise", "(/lib64/libc.so.6+0x1)"), (None, "(/lib64/libext.so+0x2)"),
    ("container_swap", "../sway/tree/container.c:9"), ("cmd_swap", "../sway/commands/swap.c:5"),
    ("execute_command", "../sway/commands.c:301")])
assert signature.crash_signature(raised, 1)["key"] == "SEGV: container_swap < cmd_swap < execute_command"
# Unsymbolized frames are never named, also in the fallback.
foreign = asan_block(9, "SEGV", [(None, "(/lib64/libx.so+0x9)")] +
                     [(f"f{n}", f"(/lib64/libx.so+0x{n})") for n in range(4)])
assert signature.crash_signature(foreign, 1)["frames"] == ["f0", "f1", "f2"]

# No in-sway frames: the first three frames of any path; no frames at all: empty.
foreign = asan_block(9, "SEGV", [(f"f{n}", f"(/lib64/libx.so+0x{n})") for n in range(5)])
assert signature.crash_signature(foreign, 1)["frames"] == ["f0", "f1", "f2"]
assert signature.crash_signature(asan_block(9, "SEGV", []), 1)["key"] == "SEGV: "

# No ASan report: the exit code is the key, frames empty, detail the log's tail.
plain = "\n".join(f"line {n}" for n in range(50)) + \
    "\n../sway/commands/mode.c:76:3: runtime error: load of value 190\n"
for code, key in ((-11, "signal:SIGSEGV"), (-6, "signal:SIGABRT"), (-200, "signal:200"),
                  (1, "exit:1"), (0, "exit:0"), (None, "unresponsive")):
    sig = signature.crash_signature(plain, code)
    assert sig == {"kind": "signal", "frames": [], "key": key,
                   "detail": "\n".join(plain.splitlines()[-30:])}, (code, sig)

COMMANDS = ["exec foot", "split h", "[con_id=@con:fixture-diff-1] focus",
            "move container to output fake-0", "nop"]

with tempfile.TemporaryDirectory(prefix="pc-test-") as work:
    work = Path(work)
    log = work / "seeds/head-0/explore.log"

    # Alive after the last step: survived, and the log is kept.
    result, record = run(Fake(), COMMANDS, log)
    assert result == {"outcome": "survived", "step": None, "error": None, "exit_code": None}, result
    assert log.read_text() == "fake sway started\n"
    # Symbolic, resolved against the live tree, and as sent (fake-N translated).
    assert record["commands"] == COMMANDS
    assert record["resolved"][2] == "[con_id=42] focus", record["resolved"]
    assert record["sent"][3] == "move container to output HEADLESS-1", record["sent"]
    assert record["resolved"][3] == COMMANDS[3]

    # ASan exits 1 at the step that killed sway; the step keeps its entries.
    result, record = run(Fake(die_at=3, code=1), COMMANDS, log)
    assert (result["outcome"], result["step"], result["exit_code"]) == ("crashed", 3, 1), result
    assert "Connection reset" in result["error"]
    assert len(record["commands"]) == len(record["resolved"]) == len(record["sent"]) == 3
    assert record["resolved"][2] == "[con_id=42] focus"

    # Death a transaction after the last reply is seen by the final liveness check.
    result, _ = run(Fake(die_at=5, code=-11, raise_on_death=False), COMMANDS, log)
    assert (result["outcome"], result["step"], result["exit_code"]) == ("crashed", 5, -11), result

    # Death after step 2's reply is seen when resolving step 3 needs the tree.
    result, record = run(Fake(die_at=2, code=-6, raise_on_death=False), COMMANDS, log)
    assert (result["outcome"], result["step"]) == ("crashed", 2), result
    assert record["commands"] == COMMANDS[:2]

    # Still running but no longer answering IPC: crashed, exit code unknown.
    result, _ = run(Fake(die_at=4, code=None), COMMANDS, log)
    assert (result["outcome"], result["step"], result["exit_code"]) == ("crashed", 4, None), result

    # The timeout wrapper or a SIGKILL ended sway: harness, never a crash.
    for code in (124, 137, -9):
        result, _ = run(Fake(die_at=2, code=code), COMMANDS, log)
        assert (result["outcome"], result["exit_code"]) == ("harness", code), (code, result)
        result, _ = run(Fake(die_at=5, code=code, raise_on_death=False), COMMANDS, log)
        assert result["outcome"] == "harness", (code, result)

    # A failing step while sway lives on is a harness problem (foot, fixture client).
    result, record = run(Fake(fail_alive_at=2), COMMANDS, log)
    assert (result["outcome"], result["step"]) == ("harness", 2), result
    assert "generated window" in result["error"] and len(record["sent"]) == 2

    # A failed start is harness, and the adapter is still stopped.
    result, record = run(Fake(fail_start=True), COMMANDS, log)
    assert result["outcome"] == "harness" and "startup failed" in result["error"], result
    assert record == sequence.new_record()

    # Missing foot is harness before anything starts.
    sequence.foot_missing = lambda: True
    result = sequence.run_sequence(Path("/bin/true"), None, sequence.Fixed(COMMANDS), sequence.new_record(), log, 7)
    assert result["outcome"] == "harness" and "foot" in result["error"], result
    sequence.foot_missing = lambda: False

    # Hinted windows are disabled when the fixture toolchain is missing.
    which = shutil.which
    shutil.which = lambda tool: None if tool == "wayland-scanner" else "/usr/bin/" + tool
    cfg, missing = explore.make_cfg(9)
    shutil.which = which
    assert missing == "wayland-scanner" and cfg["vocabulary"]["hinted_fraction"] == 0
    assert cfg["timeout"] == 9 and cfg["recipes"]
    assert v3.load_v3()[0]["hinted_fraction"] > 0  # the loaded vocabulary is not mutated
    explore.missing_fixture_toolchain = lambda: None
    cfg, missing = explore.make_cfg(9)
    assert missing is None and cfg["vocabulary"]["hinted_fraction"] > 0

    # pr-check's own recipes follow random-v3's, which stay as loaded.
    assert cfg["recipes"][:-len(coverage.EXTRA_RECIPES)] == v3.load_v3()[1]
    assert cfg["recipes"][-1] is coverage.MARK_IN_HIDDEN_SPLIT
    assert len(v3.load_v3()[1]) == 19

    # explore(): one JSONL row per seed through the worker pool, observations per step.
    install(Fake())
    out = work / "out"
    out.mkdir()
    rows = explore.explore(Path("/bin/true"), range(3, 5), 6, out, cfg, jobs=2)
    lines = [json.loads(line) for line in (out / "results.jsonl").read_text().splitlines()]
    assert sorted(row["seed"] for row in lines) == [3, 4] and len(rows) == 2
    for row in lines:
        assert set(row) == {"phase", "side", "seed", "outputs", "commands", "resolved", "sent",
                            "outcome", "step", "error", "exit_code", "signature", "log"}, row
        assert row["signature"] is None, row
        assert row["phase"] == "explore" and row["side"] == "head", row
        assert row["outcome"] == "survived" and len(row["commands"]) == 6, row
        assert row["log"] == f"seeds/head-{row['seed']}/explore.log"
        observations = (out / f"seeds/head-{row['seed']}/observations.jsonl").read_text().splitlines()
        assert [json.loads(line)["step"] for line in observations] == list(range(1, 7))
    # The same seed generates the same list.
    again = explore.explore_seed(Path("/bin/true"), 3, 6, work / "again", cfg)
    assert again["commands"] == next(row for row in lines if row["seed"] == 3)["commands"]

    # A crashed seed carries the signature of its log, read after sway was stopped.
    class Logging(Fake):
        def __init__(self, text, **kwargs):
            super().__init__(**kwargs)
            self.text = text

        def start(self, log):
            self.log = log

        def stop(self):
            self.log.write(self.text)
            super().stop()

    install(Logging(ASAN_LOG, die_at=3, code=1))
    row = explore.explore_seed(Path("/bin/true"), 3, 6, work / "asan", cfg)
    assert (row["outcome"], row["exit_code"]) == ("crashed", 1), row
    assert row["signature"]["key"] == \
        "SEGV: view_is_visible < transaction_commit < transaction_commit_pending", row
    install(Logging("no sanitizer here\n", die_at=3, code=-11, raise_on_death=False))
    row = explore.explore_seed(Path("/bin/true"), 3, 6, work / "segv", cfg)
    assert row["signature"]["key"] == "signal:SIGSEGV", row
    install(Logging("", die_at=2, code=None))
    row = explore.explore_seed(Path("/bin/true"), 3, 6, work / "hung", cfg)
    assert (row["exit_code"], row["signature"]["key"]) == (None, "unresponsive"), row

    # A seed that raises outside run_sequence becomes a harness row; others go on.
    pool.CFG = None  # explore_seed fails on cfg["vocabulary"]
    row = explore.explore_task((Path("/bin/true"), 9, 6, work / "broken", "head", None))
    assert row["outcome"] == "harness" and "TypeError" in row["error"], row

    # replay(): the explore loop on a Fixed list with the row's output layout; it records
    # its own resolution and signs a crash from its own log.
    scenarios = []
    real_adapter = runner.differential_adapter
    install(Logging(ASAN_LOG, die_at=3, code=1))
    patched = runner.differential_adapter
    runner.differential_adapter = lambda *a: scenarios.append(a[3]) or patched(*a)
    replayed = sequence.replay(Path("/bin/true"), COMMANDS, 2, work / "r/judge-head-1.log", 7)
    assert scenarios == [{"outputs": 2, "output_layout": v3.TWO_OUTPUT_LAYOUT}], scenarios
    assert (replayed["outcome"], replayed["step"]) == ("crashed", 3), replayed
    assert replayed["signature"]["key"].startswith("SEGV: view_is_visible"), replayed
    assert replayed["commands"] == COMMANDS[:3] and replayed["resolved"][2] == "[con_id=42] focus"
    assert len(replayed["sent"]) == 3 and (work / "r/judge-head-1.log").exists()
    install(Fake())
    scenarios.clear()
    patched = runner.differential_adapter
    runner.differential_adapter = lambda *a: scenarios.append(a[3]) or patched(*a)
    replayed = sequence.replay(Path("/bin/true"), COMMANDS, 1, work / "r/judge-base-1.log", 7)
    assert scenarios == [None] and replayed["outcome"] == "survived", replayed
    assert replayed["signature"] is None and replayed["sent"][3].endswith("HEADLESS-1")
    assert "observations" not in replayed
    # keep_observations: the per-step entries explore writes to observations.jsonl.
    install(Fake())
    kept = sequence.replay(Path("/bin/true"), COMMANDS, 1, work / "r/obs.log", 7, keep_observations=True)
    explored = [json.loads(line) for line in
                (out / "seeds/head-3/observations.jsonl").read_text().splitlines()]
    assert kept["observations"] == [{**entry, "step": n} for n, entry in
                                    enumerate(explored[:1] * len(COMMANDS), 1)], kept
    install(Fake(die_at=3, code=1))
    kept = sequence.replay(Path("/bin/true"), COMMANDS, 1, work / "r/obs.log", 7, keep_observations=True)
    assert kept["outcome"] == "crashed" and [o["step"] for o in kept["observations"]] == [1, 2]

    # classify() and judge(): a fake replay per binary scripts each of the 4 replays.
    S, T = "SEGV: a < b < c", "heap-use-after-free: x"

    def crashed(step, key=S):
        return {"outcome": "crashed", "step": step, "signature": {"key": key}}
    ok = {"outcome": "survived", "step": None, "signature": None}
    harness = {"outcome": "harness", "step": 2, "signature": None}
    TABLE = [  # (explorer replays, other replays, outcome)
        ([crashed(5), crashed(5)], [ok, ok], "new"),
        ([crashed(5), crashed(5)], [crashed(5), crashed(7)], "pre-existing"),
        # H is the explorer's earliest step for S across its replays, not the explore step.
        ([crashed(6), crashed(4)], [crashed(4), crashed(4)], "pre-existing"),
        ([crashed(5), crashed(5)], [crashed(5, T), crashed(5, T)], "blocked"),
        ([crashed(5), crashed(5)], [crashed(5), crashed(5, T)], "blocked"),
        ([crashed(5), crashed(5)], [crashed(2, T), crashed(2, T)], "blocked"),  # earlier, other key
        ([crashed(5), crashed(5)], [crashed(3), crashed(5)], "blocked"),  # same key, earlier step
        ([crashed(5), crashed(5)], [crashed(5), ok], "blocked"),  # 1 of 2
        ([crashed(5), crashed(5)], [ok, crashed(9, T)], "blocked"),
        ([crashed(5), ok], [ok, ok], "unconfirmed"),  # 1 of 2 on the explorer
        ([crashed(5), crashed(5, T)], [ok, ok], "unconfirmed"),
        ([ok, ok], [crashed(5), crashed(5)], "unconfirmed"),
        ([crashed(5), ok], [crashed(2, T), ok], "unconfirmed"),  # unconfirmed beats blocked
        ([crashed(5), crashed(5)], [ok, harness], "harness"),  # a harness on base
        ([harness, crashed(5)], [ok, ok], "harness"),
        ([crashed(5), ok], [harness, crashed(2, T)], "harness"),  # harness beats everything
    ]
    for explorer, other, expected in TABLE:
        assert judge.classify(S, explorer, other) == expected, (explorer, other, expected)

    HEAD, BASE = Path("/bin/true").resolve(), Path("/bin/false").resolve()
    candidate = {"phase": "explore", "side": "head", "seed": 37, "outputs": 2,
                 "commands": COMMANDS, "resolved": [], "sent": [], "outcome": "crashed",
                 "step": 5, "signature": {"key": S}}
    real_replay = sequence.replay
    for explorer, other, expected in TABLE:
        calls, script = [], {HEAD: iter(explorer), BASE: iter(other)}

        def fake_replay(binary, commands, outputs, out_log, timeout):
            calls.append((binary, commands, outputs, out_log, timeout))
            return {**next(script[binary]), "resolved": commands, "sent": commands}
        sequence.replay = fake_replay
        judged = judge.judge(candidate, HEAD, BASE, work / "judge", 11)
        assert judged["outcome"] == expected, (judged, expected)
        seed_dir = work / "judge/seeds/head-37"
        assert calls == [(HEAD, COMMANDS, 2, seed_dir / "judge-head-1.log", 11),
                         (HEAD, COMMANDS, 2, seed_dir / "judge-head-2.log", 11),
                         (BASE, COMMANDS, 2, seed_dir / "judge-base-1.log", 11),
                         (BASE, COMMANDS, 2, seed_dir / "judge-base-2.log", 11)], calls
        assert judged["head_key"] == S and judged["phase"] == "judge" and judged["seed"] == 37
        assert judged["head_steps"] == [r["step"] for r in explorer]
        assert judged["base_steps"] == [r["step"] for r in other]
        assert judged["base_keys"] == [r["signature"]["key"] if r["outcome"] == "crashed"
                                       else None for r in other], judged
        assert judged["base_outcomes"] == [r["outcome"] for r in other]

    # A base-explored row: base is the explorer and is replayed first; keys stay per side.
    # The same table with sides swapped, "new" renamed "fixed" (base crashes, head survives).
    calls, script = [], {BASE: iter([crashed(3), crashed(3)]), HEAD: iter([ok, ok])}
    judged = judge.judge({**candidate, "side": "base"}, BASE, HEAD, work / "judge", 11)
    assert [call[0] for call in calls] == [BASE, BASE, HEAD, HEAD]
    assert calls[0][3] == work / "judge/seeds/base-37/judge-base-1.log"
    assert judged["outcome"] == "fixed" and judged["base_key"] == S and "head_key" not in judged
    assert judged["base_steps"] == [3, 3] and judged["head_keys"] == [None, None], judged
    for explorer, other, expected in TABLE:
        script = {BASE: iter(explorer), HEAD: iter(other)}
        judged = judge.judge({**candidate, "side": "base"}, BASE, HEAD, work / "judge", 11)
        assert judged["outcome"] == {"new": "fixed"}.get(expected, expected), (judged, expected)
        assert judged["base_outcomes"] == [r["outcome"] for r in explorer], judged

    # The judge deadline: checked before every replay; past it the row is unjudged and
    # keeps the replays done. Each fake replay takes 1 s.
    clock = {"now": 0.0}
    real_time = time
    set_time(type("Clock", (), {"monotonic": staticmethod(lambda: clock["now"])}))

    def ticking(binary, commands, outputs, out_log, timeout):
        clock["now"] += 1
        return {**crashed(5), "resolved": commands, "sent": commands}
    sequence.replay = ticking
    judged = judge.judge(candidate, HEAD, BASE, work / "judge", 11, deadline=1.5)
    assert judged["outcome"] == "unjudged" and judged["head_steps"] == [5, 5], judged
    assert judged["base_outcomes"] == [None, None] and "error" not in judged, judged
    clock["now"] = 10.0
