def explored_row(side, seed, outcome="survived", key=None, step=None, commands=("nop",)):
    return {"phase": "explore", "side": side, "seed": seed, "outputs": 1, "commands": list(commands),
            "outcome": outcome, "step": step, "error": "boom" if outcome == "harness" else None,
            "signature": {"key": key} if key else None}


def judged_row(side, seed, outcome, key, explorer, other, steps=(4, 4)):
    other_side = "base" if side == "head" else "head"
    keys = {side: [key if o == "crashed" else None for o in explorer],
            other_side: [key if o == "crashed" else None for o in other]}
    outcomes = {side: list(explorer), other_side: list(other)}
    return {"phase": "judge", "side": side, "seed": seed, "outcome": outcome, f"{side}_key": key,
            **{f"{label}_{field}": value for label in ("head", "base") for field, value in
               (("outcomes", outcomes[label]), ("keys", keys[label]),
                ("steps", [s if o == "crashed" else None for o, s in zip(outcomes[label], steps)]))}}


