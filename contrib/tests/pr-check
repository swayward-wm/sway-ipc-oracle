    return {"phase": "judge", "side": side, "seed": seed, "outcome": outcome, f"{side}_key": key,
            **{f"{label}_{field}": value for label in ("head", "base") for field, value in
               (("outcomes", outcomes[label]), ("keys", keys[label]),
                ("steps", [s if o == "crashed" else None for o, s in zip(outcomes[label], steps)]))}}


