# A fake replay with observations: the step at which a binary's rule makes "move scratchpad"
# leave fullscreen_mode differs from the other. head_mode(commands, step) -> fullscreen_mode.
def observing(rules, calls, outcome_of=lambda side, commands: "survived"):
    def fake(binary, commands, outputs, out_log, timeout, keep_observations=False):
        side = "head" if binary == HEAD else "base"
        calls.append((side, list(commands), out_log.name))
        out_log.parent.mkdir(parents=True, exist_ok=True)
        out_log.write_text("log\n")
        kind = outcome_of(side, commands)
        observations = [obs(n, tree_of({"fullscreen_mode": rules[side](commands[:n])},
                                       base_id=10 if side == "head" else 900))
                        for n in range(1, len(commands) + 1)]
        result = {"outcome": kind, "step": None if kind == "survived" else len(commands),
                  "error": None, "exit_code": None, "signature": None,
                  "commands": list(commands), "resolved": list(commands),
                  "sent": [f"sent {c}" for c in commands]}
        return {**result, "observations": observations} if keep_observations else result
    return fake


def fixed_rule(commands):  # the root.c fix: scratchpad clears a fullscreen child
    mode = 0
    for text in commands:
        mode = 1 if text == "fs" else 0 if text == "unfs" or (text == "scratch" and mode) else mode
    return mode


def master_rule(commands):
    mode = 0
    for text in commands:
        mode = 1 if text == "fs" else 0 if text == "unfs" else mode
    return mode


