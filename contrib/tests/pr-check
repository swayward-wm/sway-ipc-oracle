def p1_tree(views):
    """A one-output tree of `views` tiled views, the last focused."""
    nodes = [dict(VIEW, app_id=f"fixture-diff-{n}", id=40 + n, focused=n == views)
             for n in range(1, views + 1)]
    ws = {"type": "workspace", "name": "1", "id": 7, "layout": "splith", "nodes": nodes,
          "floating_nodes": []}
    return {"type": "root", "id": 1, "nodes": [{"type": "output", "name": "HEADLESS-1", "id": 3,
                                                 "nodes": [ws]}]}


def p1_setups():
    """Every command list a P1 setup can expand to (alternatives and skips)."""
    lists = []
    for setup in P1["setups"]:
        expansions = [[]]
        for step in setup:
            options = step["do"] if isinstance(step["do"], list) else [step["do"]]
            expansions = [e + ([o] if o is not None else []) for e in expansions for o in options]
        lists += expansions
    return lists


single = [recipe for recipe in p1_recipes if recipe.get("outputs", 1) == 1]
p1_seeds = [seed for seed in range(200)
            if v3.V3Generator(seed, p1_vocabulary, p1_recipes).primary is P1]
assert p1_seeds and all(seed % len(single) == single.index(P1) for seed in p1_seeds), p1_seeds
window = p1_vocabulary["window"]
for seed in p1_seeds:
    gen = v3.V3Generator(seed, p1_vocabulary, p1_recipes, "auto", 40)
    commands, opened = [], 0
    for step in range(1, 30):
        command = gen.next(v3.features(p1_tree(max(opened, 1)), WORKSPACES), step)
        commands.append(command)
        opened += command.startswith(("exec ", "xdg-hinted "))
        gen.observe_reply(command, [{"success": True}])
    assert gen.started[0] == P1["name"], (seed, gen.started)
    # The first windows up to min_views, then the setup, unbroken, then the trigger.
    start = gen.primary_step - 1
    assert all(c.startswith("exec foot ") for c in commands[:start]), (seed, commands)
    trigger = commands.index("move container to mark m")
    setup = [window.format(ident="@") if c.startswith("exec foot ") else c
             for c in commands[start:trigger]]
    expected = [[window.format(ident="@") if c == v3.WINDOW_TOKEN else c for c in candidate]
                for candidate in p1_setups()]
    assert setup in expected, (seed, setup)
    assert setup[-1] == "floating enable" and "mark m" in setup and "move scratchpad" in setup
    assert gen.triggered[0] == P1["name"], (seed, gen.triggered)

