# minimise(): a fake replay per binary decides from the candidate's commands.
S, T = "SEGV: a < b < c", "heap-use-after-free: x"
HEAD, BASE = Path("/bin/true").resolve(), Path("/bin/false").resolve()


def outcome(kind, key=None, step=3):
    return {"outcome": kind, "step": step if kind != "survived" else None, "error": None,
            "exit_code": 1 if kind == "crashed" else None,
            "signature": {"key": key, "detail": f"detail of {key}"} if kind == "crashed" else None}


def scripted(head_rule, base_rule, calls):
    """A fake replay: head_rule/base_rule(commands) -> outcome; calls logs (side, commands, log)."""
    def fake(binary, commands, outputs, out_log, timeout):
        side = "head" if binary == HEAD else "base"
        calls.append((side, list(commands), out_log.name, outputs, timeout))
        result = (head_rule if side == "head" else base_rule)(commands)
        out_log.parent.mkdir(parents=True, exist_ok=True)
        out_log.write_text(f"{commands} {result['outcome']}\n")
        # Like translate_command, which only renames fake-N outputs.
        sent = [text if text.startswith("xdg-") else f"sent {text}" for text in commands]
        return {**result, "commands": list(commands), "resolved": list(commands), "sent": sent}
    return fake


def head_rule(commands):  # x crashes head with S; q without x crashes it with another key
    if "x" in commands:
        return outcome("crashed", S)
    return outcome("crashed", T) if "q" in commands else outcome("survived")


def base_rule(commands):  # y without z crashes base
    return outcome("crashed", T) if "y" in commands and "z" not in commands else outcome("survived")


def script_runs(results):
    """A fake run_script returning results[label] in turn; logs (label, script text)."""
    seen = []

    def fake(binary, script, outputs, log_path, timeout):
        label = "head" if binary == HEAD else "base"
        seen.append((label, Path(script).read_text(), log_path.name))
        return results[label].pop(0)
    return fake, seen


EXPLORED = {"phase": "explore", "side": "head", "seed": 37, "outputs": 2,
            "commands": ["p", "y", "x", "z", "q"], "resolved": ["p", "y", "x", "z", "q"],
            "sent": ["explore p", "explore y", "explore x", "explore z", "explore q"],
            "outcome": "crashed", "step": 5, "signature": {"key": S, "detail": "explore detail"}}
JUDGED = {"phase": "judge", "side": "head", "seed": 37, "outcome": "new", "head_key": S}
real_replay, real_run_script = sequence.replay, repro.run_script

with tempfile.TemporaryDirectory(prefix="pc-min-") as work:
    work = Path(work)
    calls = []
    sequence.replay = scripted(head_rule, base_rule, calls)
    repro.run_script, seen = script_runs({"head": [outcome("crashed", S)] * 2,
                                       "base": [outcome("survived")] * 2})
    row = minimise.minimise(EXPLORED, JUDGED, BASE, HEAD, work, float("inf"), n=1, timeout=13)
    assert (row["phase"], row["seed"], row["n"], row["key"]) == ("minimise", 37, 1, S), row
    assert (row["length"], row["minimised"], row["repro"], row["fallback"]) == (1, True, "verified", None), row
    saved = json.loads((work / "new-1/commands.json").read_text())
    assert saved == {"commands": ["x"], "outputs": 2, "key": S}, saved
    # A candidate that crashes base is rejected although head crashed with S: [p, y, x]
    # was probed on base, and the result keeps neither p nor y.
    probes = [(side, commands) for side, commands, log, *_ in calls if log.startswith("min-")]
    assert probes[:3] == [("head", ["z", "q"]), ("head", ["p", "y", "x"]),
                          ("base", ["p", "y", "x"])], probes
    # Head crashing with another key is not reproduced, and base is then not replayed.
    assert ("base", ["z", "q"]) not in probes, probes
    assert all(outputs == 2 and timeout == 13 for *_, outputs, timeout in calls)
    # Every probe has its own logs under the seed's directory.
    logs = [log for _, _, log, *_ in calls]
    assert len(set(logs)) == len(logs) and logs[:3] == ["min-1-head.log", "min-2-head.log", "min-2-base.log"]
    # The final check replays the minimised list 2x head, then 2x base.
    finals = [(side, commands, log) for side, commands, log, *_ in calls if log.startswith("final-")]
    assert finals == [("head", ["x"], "final-reduced-head-1.log"), ("head", ["x"], "final-reduced-head-2.log"),
                      ("base", ["x"], "final-reduced-base-1.log"), ("base", ["x"], "final-reduced-base-2.log")]
    assert row["counts"]["replay"]["reduced"]["head"]["crashed_key"] == 2
    assert row["counts"]["replay"]["reduced"]["base"]["survived"] == 2
    assert row["counts"]["replay"]["fallback"] is None
    # resolved.json and sent.json come from the final head replay; repro.sh renders sent.
    assert json.loads((work / "new-1/sent.json").read_text()) == ["sent x"]
    assert json.loads((work / "new-1/resolved.json").read_text()) == ["x"]
    assert (work / "new-1/signature.txt").read_text().startswith(f"{S}\n\ndetail of {S}")
    script = (work / "new-1/repro.sh").read_text()
    assert script.endswith("\nswaymsg 'sent x'\n") and S in script, script
    assert os.access(work / "new-1/repro.sh", os.X_OK)
    assert [(label, log) for label, _, log in seen] == [
        ("head", "repro-head-1.log"), ("head", "repro-head-2.log"),
        ("base", "repro-base-1.log"), ("base", "repro-base-2.log")], seen
    assert row["counts"]["script"] == {
        "head": {"runs": 2, "crashed_key": 2, "crashed_other": 0, "survived": 0, "harness": 0},
        "base": {"runs": 2, "crashed_key": 0, "crashed_other": 0, "survived": 2, "harness": 0}}

    # Script verification needs head's key S every time and base surviving every time.
    for head_runs, base_runs in (([outcome("crashed", S), outcome("crashed", T)], [outcome("survived")] * 2),
                                 ([outcome("crashed", S)] * 2, [outcome("survived"), outcome("harness")]),
                                 ([outcome("harness"), outcome("crashed", S)], [outcome("survived")] * 2)):
        repro.run_script, _ = script_runs({"head": list(head_runs), "base": list(base_runs)})
        row = minimise.minimise(EXPLORED, JUDGED, BASE, HEAD, work / "unverified", float("inf"),
                          n=1, timeout=13)
        assert row["repro"] == "unverified", row
        assert (work / "unverified/new-1/repro.sh").exists()
    assert row["counts"]["script"]["head"]["harness"] == 1, row

    # The minimised list fails the final check: fall back to the full list and say so.
    # Each check keeps its own logs and counts.
    def flaky_head(commands):
        if any(log.startswith("final-") for _, _, log, *_ in calls[-1:]):
            return outcome("crashed", S) if len(commands) == 5 else outcome("survived")
        return head_rule(commands)
    calls = []
    sequence.replay = scripted(flaky_head, base_rule, calls)
    repro.run_script, _ = script_runs({"head": [outcome("crashed", S)] * 2,
                                    "base": [outcome("survived")] * 2})
    row = minimise.minimise(EXPLORED, JUDGED, BASE, HEAD, work / "fallback", float("inf"), n=2, timeout=13)
    assert (row["length"], row["minimised"], row["repro"]) == (5, False, "verified"), row
    assert "did not reproduce" in row["fallback"] and "full list" in row["fallback"], row
    assert json.loads((work / "fallback/new-2/commands.json").read_text())["commands"] == EXPLORED["commands"]
    assert json.loads((work / "fallback/new-2/sent.json").read_text())[0] == "sent p"
    logs = [log for _, _, log, *_ in calls]
    assert len(set(logs)) == len(logs), logs
    assert [log for log in logs if log.startswith("final-")] == [
        "final-reduced-head-1.log", "final-reduced-head-2.log", "final-fallback-head-1.log",
        "final-fallback-head-2.log", "final-fallback-base-1.log", "final-fallback-base-2.log"], logs
    seed_logs = work / "fallback/seeds/head-37"
    assert (seed_logs / "final-reduced-head-1.log").read_text() == "['x'] survived\n"
    assert (seed_logs / "final-fallback-head-1.log").read_text() == f"{EXPLORED['commands']} crashed\n"
    assert row["counts"]["replay"] == {
        "reduced": {"head": {"runs": 2, "crashed_key": 0, "crashed_other": 0, "survived": 2, "harness": 0},
                    "base": {"runs": 0, "crashed_key": 0, "crashed_other": 0, "survived": 0, "harness": 0}},
        "fallback": {"head": {"runs": 2, "crashed_key": 2, "crashed_other": 0, "survived": 0, "harness": 0},
                     "base": {"runs": 2, "crashed_key": 0, "crashed_other": 0, "survived": 2, "harness": 0}}}, row

    # Deadline: every replay and script run checks it before starting. Each takes 1 s on a
    # fake clock; once it passes nothing else starts, the best list so far is kept and the
    # candidate is unminimised with no repro.sh.
    def timed(explored, deadline, head_rule, base_rule, name, start=0.0):
        clock = {"now": start}
        calls, seen = [], []
        fake = scripted(head_rule, base_rule, calls)

        def ticking_replay(*args):
            clock["now"] += 1
            return fake(*args)

        def ticking_script(binary, script, outputs, log_path, timeout):
            clock["now"] += 1
            seen.append(("head" if binary == HEAD else "base", log_path.name))
            return outcome("crashed", S) if binary == HEAD else outcome("survived")
        sequence.replay, repro.run_script = ticking_replay, ticking_script
        real_time = time
        set_time(type("Clock", (), {"monotonic": staticmethod(lambda: clock["now"]),
                                         "sleep": staticmethod(lambda s: None)}))
        try:
            row = minimise.minimise(explored, JUDGED, BASE, HEAD, work / name, deadline, n=1, timeout=13)
        finally:
            set_time(real_time)
        saved = json.loads((work / name / "new-1/commands.json").read_text())["commands"]
        assert len(saved) == row["length"]
        return row, [(side, log) for side, _, log, *_ in calls], seen, saved

    def unminimised(row, name, explored, partial=None):
        """Out of time: the full explored list is the candidate's; best.json the partial one."""
        assert (row["minimised"], row["repro"]) == (False, "unminimised"), row
        assert row["counts"]["script"] is None and not (work / name / "new-1/repro.sh").exists()
        saved = json.loads((work / name / "new-1/commands.json").read_text())["commands"]
        assert saved == explored["commands"] and row["length"] == len(saved), (saved, row)
        best = work / name / "new-1/best.json"
        if partial is None:
            assert row["partial"] is None and not best.exists(), row
        else:
            assert json.loads(best.read_text())["commands"] == partial, best.read_text()
            assert row["partial"] == len(partial), row

    # Probes [z,q] (head only, t=0..1), [p,y,x] (2 s), [x,z,q] (2 s, accepted at t=5); [z,q]'s
    # next probe would start at t=5 > 4.5.
    row, calls, seen, saved = timed(EXPLORED, 4.5, head_rule, base_rule, "late")
    unminimised(row, "late", EXPLORED, ["x", "z", "q"])
    assert calls == [("head", "min-1-head.log"), ("head", "min-2-head.log"), ("base", "min-2-base.log"),
                     ("head", "min-3-head.log"), ("base", "min-3-base.log")] and seen == [], calls
    assert row["counts"]["replay"] == {"reduced": None, "fallback": None}
    # The full list keeps the explore record's resolved and sent.
    assert json.loads((work / "late/new-1/sent.json").read_text()) == EXPLORED["sent"]
    # Expiring during a head probe: base is not started; nothing was accepted, so no best.json.
    row, calls, seen, saved = timed(EXPLORED, 1.5, head_rule, base_rule, "mid-head")
    unminimised(row, "mid-head", EXPLORED)
    assert calls == [("head", "min-1-head.log"), ("head", "min-2-head.log")] and seen == [], calls
    assert row["counts"]["probes"] == 2
    # The last reduction reaches one command, so the minimiser returns without another probe.
    pair = {**EXPLORED, "commands": ["a", "b"]}
    b_crashes = lambda c: outcome("crashed", S) if "b" in c else outcome("survived")
    survives = lambda c: outcome("survived")
    probe = [("head", "min-1-head.log"), ("base", "min-1-base.log")]
    reduced = [("head", "final-reduced-head-1.log"), ("head", "final-reduced-head-2.log"),
               ("base", "final-reduced-base-1.log"), ("base", "final-reduced-base-2.log")]
    scripts = [("head", "repro-head-1.log"), ("head", "repro-head-2.log"),
               ("base", "repro-base-1.log"), ("base", "repro-base-2.log")]
    # With time left: the final check and the script runs follow.
    row, calls, seen, saved = timed(pair, 100, b_crashes, survives, "one-left")
