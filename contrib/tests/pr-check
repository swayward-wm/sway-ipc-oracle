# --diffs: the exact sway-vs-sway comparison. normalised() drops runtime ids at any depth and
# maps focus ids to indexes into the step's sorted node ids; nothing else is relaxed.
from prcheck import behaviour, diffs  # noqa: E402


def obs(step, tree, reply=None, workspaces=()):
    return {"step": step, "reply": reply or [{"success": True}], "tree": tree,
            "workspaces": list(workspaces)}


def tree_of(*views, focus=None, base_id=10, **extra):
    """A root with one workspace holding views (dicts merged into a con)."""
    nodes = [{"id": base_id + 1 + n, "type": "con", "pid": 4000 + n, "window": None,
              "foreign_toplevel_identifier": f"rand{base_id}{n}", "name": f"v{n}",
              "fullscreen_mode": 0, "rect": {"x": 0, "y": 0, "width": 640, "height": 720},
              "nodes": [], "focus": [], **view} for n, view in enumerate(views)]
    ids = [node["id"] for node in nodes]
    return {"id": base_id, "type": "root", "nodes": [
        {"id": base_id + 100, "type": "workspace", "nodes": nodes,
         "focus": [ids[i] for i in (focus if focus is not None else range(len(ids)))], **extra}]}


