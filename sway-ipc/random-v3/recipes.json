     "focus parent",
     "floating enable"
    ],
    [
     "focus parent",
     "floating enable"
    ]
   ],
   "triggers": [
    "focus child",
    "move container to output {o}",
    "split v",
    "kill",
    "fullscreen toggle",
    "move container to workspace {ws_other}"
   ]
  },
  {
   "name": "R5-build-nest",
   "axes": [
    "depth",
    "tabbed"
   ],
   "min_views": 0,
   "requires": [
    "views<=6"
