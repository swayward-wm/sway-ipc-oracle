{
 "description": "random-v3 recipes: precondition builders that end at 1-3 trigger steps (see contrib/sway_ipc_v3.py). A step is a command template, a list of alternatives (null skips), or {do, guard, glue}. R14 (multi-output) is not implemented yet.",
 "recipes": [
  {
   "name": "R1-fs-then-structure",
   "axes": [
    "fs",
    "fs_structure"
   ],
   "min_views": 2,
   "requires": [
    "!global_fs",
    "focused_fs==0"
   ],
   "setups": [
    [
     [
      "fullscreen toggle",
      "fullscreen enable",
      "fullscreen toggle global"
     ]
    ]
   ],
   "triggers": [
    "splitv",
    "split toggle",
    "@window",
    "[app_id=\"{sibling}\"] kill",
    "focus tiling",
    "focus floating",
    "layout tabbed",
    "move container to workspace next",
    "floating toggle",
    "swap container with mark {mark}",
    "kill",
    "fullscreen disable"
   ]
  },
  {
   "name": "R2-float-fs-split",
   "axes": [
    "floating",
    "fs"
   ],
   "min_views": 1,
   "requires": [
    "focus_kind==view",
    "focused_fs==0"
   ],
   "setups": [
    [
     {
      "do": "floating enable",
      "guard": [
       "focus_kind==view"
      ]
     },
     [
      "fullscreen enable",
      "fullscreen toggle global"
     ]
    ]
   ],
   "triggers": [
    "splith",
    "split toggle",
    "@window",
    "fullscreen disable",
    "move container to workspace 2",
    "kill"
   ]
  },
  {
   "name": "R3-float-split-group",
   "axes": [
    "floating_split"
   ],
   "min_views": 1,
   "requires": [
    "focus_kind==view",
    "!focused_floating"
   ],
   "setups": [
    [
     "floating enable",
     [
      "splith",
      "splitv",
      "splitt"
     ],
     [
      "@window",
      null
     ]
    ]
   ],
   "triggers": [
    "move container to workspace 2",
    "[floating] border pixel 4",
    "[tiling] mark --add x",
    "layout tabbed",
    "floating disable",
    "focus parent; floating toggle",
    "move scratchpad",
    "kill",
    "focus parent"
   ]
  },
  {
   "name": "R4-group-float",
   "axes": [
